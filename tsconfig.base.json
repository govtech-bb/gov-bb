{
  // Shared settings for every project. A project overrides only what it has
  // to: CommonJS builds (the api and the libraries it runs from dist) set
  // `module`/`moduleResolution` and turn `verbatimModuleSyntax` off; React apps
  // add `jsx`, DOM `lib`s and `noEmit`.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "paths": {
      "@govtech-bb/admin-ui": ["./packages/admin-ui/src/index.ts"],
      "@govtech-bb/analytics": ["./packages/analytics/src/index.ts"],
      "@govtech-bb/content": ["./packages/content/src/index.ts"],
      "@govtech-bb/govbbmarkd": ["./packages/govbbmarkd/src/index.ts"],
      "@govtech-bb/govbbmarkd/react": [
        "./packages/govbbmarkd/src/markdown-react.tsx"
      ],
      "@govtech-bb/govbbmarkd/legacy": [
        "./packages/govbbmarkd/src/legacy-markdown.ts"
      ],
      "@govtech-bb/govbbmarkd/content-url": [
        "./packages/govbbmarkd/src/content-url.ts"
      ],
      "@govtech-bb/govbbmarkd/contact-record": [
        "./packages/govbbmarkd/src/contact-record.ts"
      ],
      "@govtech-bb/content/categories": [
        "./packages/content/src/categories.ts"
      ],
      "@govtech-bb/form-builder": ["./packages/form-builder/src/index.ts"],
      "@govtech-bb/form-types": ["./packages/form-types/src/index.ts"],
      "@govtech-bb/expressions": ["./packages/expressions/src/index.ts"],
      "@govtech-bb/form-conditions": [
        "./packages/form-conditions/src/index.ts"
      ],
      "@govtech-bb/form-validation": [
        "./packages/form-validation/src/index.ts"
      ],
      "@govtech-bb/registry": ["./packages/registry/src/index.ts"],
      "@govtech-bb/submission-summary": [
        "./packages/submission-summary/src/index.ts"
      ],
      "@govtech-bb/database": ["./packages/database/src/index.ts"],
      "@govtech-bb/git-publish": ["./packages/git-publish/src/index.ts"],
      "@forms/types": ["./apps/forms/src/types/index.ts"],
      "@forms/lib": ["./apps/forms/src/lib/form-builder/index.ts"],
      "@forms/form-api": ["./apps/forms/src/lib/api/forms.ts"],
      "@forms/components": ["./apps/forms/src/components"]
    }
  }
}
