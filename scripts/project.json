{
  "name": "scripts",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json"],
      "options": {
        "command": "vitest run",
        "cwd": "scripts"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --fix",
        "cwd": "scripts"
      }
    },
    "test:oxlint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint",
        "cwd": "scripts"
      }
    }
  },
  "tags": []
}
