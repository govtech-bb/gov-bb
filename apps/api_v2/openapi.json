                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": ["conflict"]
                    },
                    "message": {
                      "type": "string"
                    },
                    "documentId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": ["error", "message", "documentId"],
                  "additionalProperties": true
                }
              }
            }
