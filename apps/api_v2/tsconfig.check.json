{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    // exactOptionalPropertyTypes remains a separate migration: auth.spec.ts, better-auth.test.ts,
    // import-estate.ts and route-auth.test.ts still pass explicit undefined to optional fields.
    // The seed builder reads the category taxonomy from packages/content's source.
    "rootDir": "../.."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.json",
    "e2e/**/*.ts",
    "browser/**/*.ts",
    "scripts/**/*.ts",
    "vitest*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
