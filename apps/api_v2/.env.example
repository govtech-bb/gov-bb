# Supply these variables to the API process; main.ts does not load .env files.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=gov_bb_v2
PORT=3020
NODE_ENV=development
# Production verifies certificates. Optionally provide PEM contents or a CA path.
# DB_SSL_CA=/path/to/ca.pem
# Load the committed estate snapshot on boot. Additive, but it re-adds pages an
# editor deleted, so leave it off once people are editing.
SEED=true

# Public origins only: no paths, query strings, credentials, or fragments.
# Production requires HTTPS and a same-site editor/API deployment.
BETTER_AUTH_URL=http://localhost:3020
EDITOR_ORIGIN=http://localhost:3000
# Generate at least 32 characters; keep the value stable across process restarts.
BETTER_AUTH_SECRET=
# A Web application OAuth client under the Workspace's Internal consent screen.
# Register this exact development callback:
# http://localhost:3020/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Workspace domains whose verified accounts may sign in.
GOOGLE_ALLOWED_DOMAINS=govtech.bb
# The site's preview token. Landing's server sends it as x-preview-token to
# read preview content; unset, every preview read is refused.
# PREVIEW_SECRET=
# Landing's token. Landing's server sends it as x-landing-token and is then
# not rate-limited; unset, nobody is exempt.
# LANDING_SECRET=
# Required unless AUTH_BYPASS=true: comma-separated emails granted the admin
# role whenever they sign in. Without an admin nobody can grant approver (ADR 0079).
API_V2_ADMIN_EMAILS=
# Optional, comma-separated old=new pairs: moves a GitHub-era user to their
# Workspace address on boot, keeping their id, roles and history (#3418).
# API_V2_EMAIL_MOVES=
