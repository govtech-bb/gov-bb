{
  "info": {
    "name": "api_v2",
    "description": "Requests for apps/api_v2. Full reference: {{baseUrl}}/docs (spec at {{baseUrl}}/docs/openapi.json).\n\nPublic and Navigation requests work with no setup. Preview requests send the `previewToken` variable as `x-preview-token`; it must equal the API's PREVIEW_SECRET (`local-preview-secret` in the README's local run). Editor requests need an employee session. Locally, run the API with `AUTH_BYPASS=true` and they work with no sign-in. Otherwise sign in to the editor with GitHub as a govtech-bb organization member, then copy the `better-auth.session_token` cookie value into the `sessionToken` collection variable. Writes also send `Origin: {{editorOrigin}}`, which must match the API's EDITOR_ORIGIN.\n\nRun the Editor folder top to bottom: Create stores `pageId`, `pageUrl` and `updatedAt`; Create a sub-page stores `subPageId`; the deletes clean both up.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3020"
    },
    {
      "key": "editorOrigin",
      "value": "http://localhost:3000"
    },
    {
      "key": "sessionToken",
      "value": ""
    },
    {
      "key": "publicUrl",
      "value": "/business-trade/crop-over-permits"
    },
    {
      "key": "pageId",
      "value": ""
    },
    {
      "key": "pageUrl",
      "value": ""
    },
    {
      "key": "updatedAt",
      "value": ""
    },
    {
      "key": "previewToken",
      "value": "local-preview-secret"
    },
    {
      "key": "categorySlug",
      "value": "health-and-emergency-services"
    },
    {
      "key": "subPageId",
      "value": ""
    },
    {
      "key": "serviceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Docs",
      "item": [
        {
          "name": "API reference (HTML)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/docs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 HTML', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "OpenAPI document",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/docs/openapi.json"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OpenAPI 3.0.3', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().openapi).to.eql('3.0.3');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Public",
      "item": [
        {
          "name": "Get a public page by its url",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/pages?url={{publicUrl}}",
              "host": ["{{baseUrl}}"],
              "path": ["pages"],
              "query": [
                {
                  "key": "url",
                  "value": "{{publicUrl}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 with page body', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.url).to.eql(pm.collectionVariables.get('publicUrl'));",
                  "  pm.expect(body).to.have.property('body_markdown');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get a page that does not exist (404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/pages?url=/no/such/page",
              "host": ["{{baseUrl}}"],
              "path": ["pages"],
              "query": [
                {
                  "key": "url",
                  "value": "/no/such/page"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 not_found', () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().error).to.eql('not_found');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Version without a session (401; 200 under AUTH_BYPASS)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/version"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 unauthenticated, unless AUTH_BYPASS is on', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([401, 200]);",
                  "  if (pm.response.code === 401) pm.expect(pm.response.json().error).to.eql('unauthenticated');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Navigation",
      "item": [
        {
          "name": "Category tree",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200, public-cacheable', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.include('public');",
                  "  pm.expect(pm.response.json().categories.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "A category's listing",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories/{{categorySlug}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 with root pages only', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const urls = pm.response.json().pages.map((p) => p.url);",
                  "  pm.expect(urls.some((u) => u.endsWith('/start'))).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "A category that lists nothing (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories/housing"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Catalog",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/catalog"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200, no start steps', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const urls = pm.response.json().pages.map((p) => p.url);",
                  "  pm.expect(urls.some((u) => u.endsWith('/start'))).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Search documents",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/search/documents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 with chunks', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const docs = pm.response.json().documents;",
                  "  pm.expect(docs.some((d) => d.chunks.length > 0)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Breadcrumbs follow the parent, not the url",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pages?url=/health-and-emergency-services/prescription-colours"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('pharmacy finder is in the trail', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const crumbs = pm.response.json().breadcrumbs.map((c) => c.url);",
                  "  pm.expect(crumbs).to.include('/health-and-emergency-services/find-an-open-pharmacy');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Preview",
      "item": [
        {
          "name": "Category tree with the preview token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories",
            "header": [
              {
                "key": "x-preview-token",
                "value": "{{previewToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200, never cached', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
                  "  pm.expect(pm.response.headers.get('ETag')).to.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "A preview-only subcategory",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories/youth-and-community/arts-culture",
            "header": [
              {
                "key": "x-preview-token",
                "value": "{{previewToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 under its parent', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().parent.slug).to.eql('youth-and-community');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Same subcategory without the token (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories/youth-and-community/arts-culture"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong preview token (401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/catalog",
            "header": [
              {
                "key": "x-preview-token",
                "value": "wrong"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 invalid_preview_token', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error).to.eql('invalid_preview_token');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Start GitHub sign-in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/sign-in/social",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"github\",\n  \"callbackURL\": \"{{editorOrigin}}\"\n}"
            },
            "description": "Returns the GitHub URL to open in a browser. Postman cannot complete the OAuth redirect itself; after signing in, copy the better-auth.session_token cookie from the browser into the sessionToken variable."
          }
        },
        {
          "name": "Get current session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "better-auth.session_token={{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/get-session"
          }
        }
      ]
    },
    {
      "name": "Editor",
      "description": "Requires the sessionToken variable.",
      "item": [
        {
          "name": "Version",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "better-auth.session_token={{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/version"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 with count', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.property('count');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List services",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "better-auth.session_token={{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/services"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 with services', () => pm.response.to.have.status(200));",
                  "const [first] = pm.response.json();",
                  "if (first) pm.collectionVariables.set('serviceId', first.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Open a service",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "better-auth.session_token={{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/services/{{serviceId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 with its pages, entry first', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().pages[0].role).to.equal('entry');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Every category, for filing pages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "better-auth.session_token={{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/taxonomy"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 with categories and ids', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().categories[0]).to.have.property('id');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a page",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "better-auth.session_token={{sessionToken}}"
              },
              {
                "key": "Origin",
                "value": "{{editorOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/pages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"/postman-test-{{$timestamp}}\",\n  \"title\": \"Postman test page\",\n  \"visibility\": \"draft\",\n  \"body_markdown\": \"Created from Postman.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));",
                  "const page = pm.response.json();",
                  "pm.collectionVariables.set('pageId', page.id);",
                  "pm.collectionVariables.set('pageUrl', page.url);",
                  "pm.collectionVariables.set('updatedAt', page.updated_at);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a sub-page",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "better-auth.session_token={{sessionToken}}"
              },
              {
                "key": "Origin",
                "value": "{{editorOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/pages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{pageUrl}}/start\",\n  \"title\": \"Before you start\",\n  \"parent_id\": \"{{pageId}}\",\n  \"visibility\": \"draft\",\n  \"body_markdown\": \"A sub-page.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 beneath the page', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().parent_id).to.eql(pm.collectionVariables.get('pageId'));",
                  "});",
                  "pm.collectionVariables.set('subPageId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get a page by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "better-auth.session_token={{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/pages/{{pageId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('updatedAt', pm.response.json().updated_at);"
                ]
              }
            }
          ]
        },
        {
          "name": "Save a page",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Cookie",
                "value": "better-auth.session_token={{sessionToken}}"
              },
              {
                "key": "Origin",
                "value": "{{editorOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "if-updated-at",
                "value": "{{updatedAt}}"
              }
            ],
            "url": "{{baseUrl}}/pages/{{pageId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{pageUrl}}\",\n  \"category_id\": null,\n  \"title\": \"Postman test page (edited)\",\n  \"description\": null,\n  \"visibility\": \"draft\",\n  \"form_id\": null,\n  \"body_markdown\": \"Edited from Postman.\",\n  \"frontmatter\": {}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 saved', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('updatedAt', pm.response.json().updated_at);"
                ]
              }
            }
          ]
        },
        {
          "name": "Save with a stale if-updated-at (409)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Cookie",
                "value": "better-auth.session_token={{sessionToken}}"
              },
              {
                "key": "Origin",
                "value": "{{editorOrigin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "if-updated-at",
                "value": "2000-01-01T00:00:00.000Z"
              }
            ],
            "url": "{{baseUrl}}/pages/{{pageId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{pageUrl}}\",\n  \"category_id\": null,\n  \"title\": \"Stale write\",\n  \"description\": null,\n  \"visibility\": \"draft\",\n  \"form_id\": null,\n  \"body_markdown\": \"Should be refused.\",\n  \"frontmatter\": {}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 conflict', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().error).to.eql('conflict');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create without Origin (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "better-auth.session_token={{sessionToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/pages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"/postman-no-origin\",\n  \"title\": \"No origin\",\n  \"body_markdown\": \"Should be refused.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete a page that has sub-pages (422)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "better-auth.session_token={{sessionToken}}"
              },
              {
                "key": "Origin",
                "value": "{{editorOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/pages/{{pageId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('422 on id', () => {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(pm.response.json().errors[0].field).to.eql('id');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete the sub-page",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "better-auth.session_token={{sessionToken}}"
              },
              {
                "key": "Origin",
                "value": "{{editorOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/pages/{{subPageId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete a page",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "better-auth.session_token={{sessionToken}}"
              },
              {
                "key": "Origin",
                "value": "{{editorOrigin}}"
              }
            ],
            "url": "{{baseUrl}}/pages/{{pageId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204 deleted', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
