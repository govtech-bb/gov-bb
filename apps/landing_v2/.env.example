VITE_SITE_URL=http://localhost:3050

# Content API base URL: server-only (no VITE_ prefix), read per request.
# Nitro loads .env in dev only, so `start` needs it exported in the shell.
CONTENT_API_URL=http://localhost:3040

# Base URL of the deployed forms app, used for the Start button. Defaults to
# the sandbox forms host in code; set this for a local forms dev server.
VITE_FORMS_URL=http://localhost:3000
