# Base URL of api_v2, the content API every page is read from.
#
# SERVER-ONLY: no VITE_ prefix, so it is never shipped to the client bundle.
# Only landing_v2's server calls api_v2 — the route loaders call server
# functions, and api_v2's CORS does not admit this app — so the browser never
# needs it.
#
# Because the Amplify SSR Lambda never sees Console env vars at runtime, this
# is snapshotted into the Nitro runtimeConfig at build time (see
# vite.config.ts), and changing it needs a redeploy. A production build
# without it fails. `vite dev` falls back to http://localhost:3020, api_v2's
# local port.
API_V2_URL=http://localhost:3020

# Base URL of the forms app. A Start button whose target is a form links to
#   ${FORMS_URL}/<form id>
# Server-only and build-baked in exactly the same way as API_V2_URL: a
# production build without it fails, and `vite dev` falls back to
# http://localhost:3000, the forms app's local port.
FORMS_URL=http://localhost:3000
