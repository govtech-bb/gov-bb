# `.env` is read by `vite dev` only; export the variables in the shell for
# `vite build`.

# Base URL of api_v2, the content API every page is read from.
#
# SERVER-ONLY: no VITE_ prefix, so it is never shipped to the client bundle.
# Only landing_v2's server calls api_v2 — the route loaders call server
# functions, and api_v2's CORS does not admit this app — so the browser never
# needs it.
#
# Because the Amplify SSR Lambda never sees Console env vars at runtime, this
# is snapshotted into the Nitro runtimeConfig at build time from the
# environment `vite build` runs in (see vite.config.ts), and changing it needs
# a redeploy. A build without it still succeeds, so CI can build with no
# environment, but the built server then fails at its first request with an
# error naming API_V2_URL. `vite dev` reads it from the environment it was
# started in, and falls back to http://localhost:3020, api_v2's local port.
API_V2_URL=http://localhost:3020

# Base URL of the forms app. A Start button whose target is a form links to
#   ${FORMS_URL}/forms/<form id>
# A public link target, so this is server-configured, not secret — but it is
# still build-baked in exactly the same way as API_V2_URL: a built server
# without it fails at its first request with an error naming FORMS_URL, and
# `vite dev` falls back to http://localhost:3000, the forms app's local port.
FORMS_URL=http://localhost:3000
