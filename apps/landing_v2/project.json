{
  "name": "landing_v2",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/landing_v2/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.amplify-hosting"],
      "options": {
        "command": "pnpm run build",
        "cwd": "apps/landing_v2"
      },
      "inputs": [
        "production",
        "^production",
        {
          "env": "API_V2_URL"
        },
        {
          "env": "FORMS_URL"
        }
      ]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run dev",
        "cwd": "apps/landing_v2"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test",
        "cwd": "apps/landing_v2"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "apps/landing_v2"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/landing_v2/**/*.{ts,tsx}"]
      }
    }
  },
  "tags": ["spike"]
}
