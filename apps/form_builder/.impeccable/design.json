      "css": ".ds-field{font-family:Inter,system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;font-size:14px;letter-spacing:-.15px;margin-bottom:18px;}.ds-label{display:block;margin-bottom:6px;font-size:13px;font-weight:500;color:var(--el-800,#3a3a3a);}.ds-input{width:100%;padding:9px 12px;border:1px solid var(--el-200,#e5e5e5);border-radius:var(--rad-s,6px);background:var(--el-0,#ffffff);color:var(--txt,#1c1c1c);font-size:14px;font-family:inherit;}.ds-input:focus,.ds-input:focus-visible{outline:none;border-color:var(--el-500,#8a8a8a);box-shadow:0 0 0 2px rgba(0,0,0,.06);}"
