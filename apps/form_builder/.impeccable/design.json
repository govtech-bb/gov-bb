      "css": ".ds-primary{display:inline-flex;align-items:center;gap:7px;border-radius:var(--rad-m,8px);font-size:13.5px;font-weight:500;letter-spacing:-0.15px;text-decoration:none;cursor:pointer;font-family:Inter,system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;padding:9px 16px;border:none;background:var(--el-1000,#1c1c1c);color:var(--on-inverse,#ffffff);transition:background .15s,opacity .15s;}.ds-primary:hover:not(:disabled){background:var(--el-800,#3a3a3a);}.ds-primary:focus-visible{outline:2px solid currentColor;outline-offset:2px;}.ds-primary:disabled{opacity:.4;cursor:not-allowed;}"
