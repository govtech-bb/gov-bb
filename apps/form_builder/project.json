{
  "name": "form-builder-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/form_builder/app",
  "projectType": "application",
  "targets": {
    "build": {
      "dependsOn": [],
      "inputs": [
        "production",
        "^production",
        { "env": "BUILDER_API_URL" },
        { "env": "FORM_BUILDER_GITHUB_OAUTH_SECRET_ARN" },
        { "env": "FORM_BUILDER_TOKENS_SECRET_ARN" },
        { "env": "GITHUB_ORG" },
        { "env": "GITHUB_TEAM_SLUG" },
        { "env": "NITRO_PRESET" },
        { "env": "OAUTH_REDIRECT_BASE" },
        { "env": "PUBLISH_BASE_BRANCH" },
        { "env": "VITE_FORMS_PREVIEW_URL" },
        { "env": "VITE_FORMS_URL" },
        { "env": "VITE_LANDING_PREVIEW_URL" },
        { "env": "VITE_RECIPE_PREVIEW_TOKEN" }
      ]
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/api/src/forms/form-definitions/recipes/**/*.json"
      ]
    }
  },
  "tags": []
}
