{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "verbatimModuleSyntax": false,
    "outDir": "dist",
    "rootDir": "src",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    // Compile only src/: workspace packages resolve through node_modules as
    // external packages (the runtime loads their built dist), not as source
    // pulled into this program — which `rootDir: "src"` would reject.
    "paths": {}
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "**/*.spec.ts", "src/test-helpers"]
}
