{
  "name": "forms",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/forms/src",
  "projectType": "application",
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [],
      "inputs": [
        "production",
        "^production",
        {
          "env": "VITE_API_URL"
        },
        {
          "env": "VITE_LANDING_URL"
        },
        {
          "env": "VITE_PAYMENT_ALLOWED_ORIGINS"
        },
        {
          "env": "VITE_UMAMI_SRC"
        },
        {
          "env": "VITE_UMAMI_WEBSITE_ID"
        }
      ]
    },
    "start": {
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/forms/**/*.{ts,tsx}"]
      }
    }
  },
  "tags": []
}
