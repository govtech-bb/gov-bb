{
  "first-name": {
    "kind": "text",
    "settings": {
      "hasMinCharacters": true,
      "minCharacters": 2,
      "pattern": "^\\s*\\p{L}(?:[\\p{L}\\p{M}\\s'’.-]*[\\p{L}\\p{M}.])?\\s*$",
      "ref": "components/first-name",
      "required": true
    }
  },
  "middle-name": {
    "kind": "text",
    "settings": {
      "hasMinCharacters": true,
      "minCharacters": 2,
      "pattern": "^\\s*\\p{L}(?:[\\p{L}\\p{M}\\s'’.-]*[\\p{L}\\p{M}.])?\\s*$",
      "ref": "components/middle-name"
    }
  },
  "last-name": {
    "kind": "text",
    "settings": {
      "hasMinCharacters": true,
      "minCharacters": 2,
      "pattern": "^\\s*\\p{L}(?:[\\p{L}\\p{M}\\s'’.-]*[\\p{L}\\p{M}.])?\\s*$",
      "ref": "components/last-name",
      "required": true
    }
  },
  "name": {
    "kind": "text",
    "settings": {
      "hasMinCharacters": true,
      "minCharacters": 2,
      "pattern": "^\\s*\\p{L}(?:[\\p{L}\\p{M}\\s'’.-]*[\\p{L}\\p{M}.])?\\s*$",
      "ref": "components/name",
      "required": true
    }
  },
  "title": {
    "kind": "dropdown",
    "settings": {
      "width": "short",
      "placeholder": "Select a title",
      "ref": "components/title",
      "required": true
    },
    "options": ["Mr", "Miss", "Ms", "Mrs", "Dr"]
  },
  "date-of-birth": {
    "kind": "date",
    "settings": {
      "relativeDate": "past",
      "ref": "components/date-of-birth",
      "required": true
    }
  },
  "sex": {
    "kind": "multiple-choice",
    "settings": {
      "ref": "components/sex",
      "required": true
    },
    "options": ["Male", "Female"]
  },
  "national-id-number": {
    "kind": "text",
    "settings": {
      "width": "medium",
      "pattern": "^\\d{6}-\\d{4}$",
      "mask": "999999-9999",
      "ref": "components/national-id-number",
      "errors": {
        "required": "Enter your National ID number"
      },
      "required": true
    }
  },
  "national-insurance-number": {
    "kind": "text",
    "settings": {
      "width": "short",
      "pattern": "^\\d{6}$",
      "mask": "999999",
      "ref": "components/national-insurance-number",
      "errors": {
        "required": "Enter your National Insurance number"
      },
      "required": true
    }
  },
  "passport-number": {
    "kind": "text",
    "settings": {
      "width": "short",
      "hasMinCharacters": true,
      "minCharacters": 6,
      "ref": "components/passport-number",
      "required": true
    }
  },
  "tamis-number": {
    "kind": "text",
    "settings": {
      "hasMinCharacters": true,
      "minCharacters": 10,
      "hasMaxCharacters": true,
      "maxCharacters": 15,
      "pattern": "^\\d+$",
      "ref": "components/tamis-number",
      "required": true
    }
  },
  "address": {
    "kind": "text",
    "settings": {
      "hasMinCharacters": true,
      "minCharacters": 5,
      "ref": "components/address",
      "required": true
    }
  },
  "parish": {
