{
  "schemaVersion": 2,
  "id": "reserve-society-name",
  "title": "Reserve a Society Name",
  "description": "Request to search, reserve, or change a society name.",
  "mode": "application",
  "locale": "en-BB",
  "timeZone": "America/Barbados",
  "settings": {
    "visibility": "draft",
    "hiddenAnswers": "retain",
    "notifications": {
      "department": {
        "enabled": true,
        "recipient": {
          "context": "departmentEmail"
        }
      }
    }
  },
  "blocks": [
    {
      "id": "page-request-details",
      "type": "page",
      "role": "questions",
      "title": "What do you want to do?"
    },
    {
      "id": "request-purpose",
      "type": "question",
      "kind": "choice",
      "key": "request-purpose",
      "label": "What do you want to do?",
      "options": [
        {
          "id": "option-1",
          "label": "Search if society name is available",
          "value": "request-search"
        },
        {
          "id": "option-2",
          "label": "Reserve a society name",
          "value": "reserve-name"
        },
        {
          "id": "option-3",
          "label": "Change the name of an existing society",
          "value": "change-name"
        }
      ],
      "config": {
        "selection": "single",
        "presentation": "radio"
      },
      "required": {
        "value": true,
        "message": "Select what you want to do"
      }
    },
    {
      "id": "current-society-name",
      "type": "question",
      "kind": "text",
      "key": "current-society-name",
      "label": "What is the current name of the society?",
      "required": {
        "value": true,
        "message": "Current society name is required"
      },
      "visible": false
    },
    {
      "id": "request-details-logic",
      "type": "logic",
      "rules": [
        {
          "id": "current-society-name-fieldConditionalOn-1",
          "when": {
            "op": "eq",
            "left": {
              "answer": "request-purpose"
            },
            "right": "change-name"
          },
          "actions": [
            {
              "type": "setVisible",
              "targets": [
                "current-society-name"
              ],
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "page-proposed-names",
      "type": "page",
      "role": "questions",
      "title": "What are your proposed society names?",
      "description": "You can suggest up to 3 names. Provide at least one."
    },
    {
      "id": "society-name-1",
      "type": "question",
      "kind": "text",
      "key": "society-name-1",
      "label": "First choice of society name",
      "required": {
        "value": true,
        "message": "At least one society name is required"
      },
      "validation": [
        {
          "id": "minLength",
          "type": "minLength",
          "message": "Must be at least 2 characters",
          "value": 2
        }
      ]
    },
    {
      "id": "society-name-1-explanation",
      "type": "question",
      "kind": "long-text",
      "key": "society-name-1-explanation",
      "label": "How did you choose this name?",
      "required": {
        "value": true,
        "message": "Explanation is required"
      },
      "validation": [
        {
          "id": "minLength",
          "type": "minLength",
          "message": "Must be at least 2 characters",
          "value": 2
        }
      ]
    },
    {
      "id": "society-name-2",
      "type": "question",
      "kind": "text",
      "key": "society-name-2",
      "label": "Second choice of society name",
      "hint": "Leave blank if you only have one choice",
      "required": {
        "value": false,
        "message": ""
      }
    },
    {
      "id": "society-name-2-explanation",
      "type": "question",
      "kind": "long-text",
      "key": "society-name-2-explanation",
      "label": "How did you choose this name?"
    },
    {
      "id": "society-name-3",
      "type": "question",
      "kind": "text",
      "key": "society-name-3",
      "label": "Third choice of society name",
      "hint": "Leave blank if you only have two choices",
      "required": {
        "value": false,
        "message": ""
      }
    },
    {
      "id": "society-name-3-explanation",
      "type": "question",
      "kind": "long-text",
      "key": "society-name-3-explanation",
      "label": "How did you choose this name?"
    },
    {
      "id": "page-society-activities",
      "type": "page",
      "role": "questions",
      "title": "What does the society do?",
      "description": "List the main activities of the society (up to 3)"
    },
    {
      "id": "activity-1",
      "type": "question",
      "kind": "long-text",
      "key": "activity-1",
      "label": "Activity 1",
      "required": {
        "value": true,
        "message": "At least one activity is required"
      }
    },
    {
      "id": "activity-2",
      "type": "question",
      "kind": "long-text",
      "key": "activity-2",
      "label": "Activity 2"
    },
    {
      "id": "activity-3",
      "type": "question",
      "kind": "long-text",
      "key": "activity-3",
      "label": "Activity 3"
    },
    {
      "id": "page-applicant-details",
      "type": "page",
      "role": "questions",
      "title": "Tell us about yourself"
    },
    {
      "id": "applicant-title",
      "type": "question",
      "kind": "choice",
      "key": "applicant-title",
      "label": "Title",
      "options": [
        {
          "id": "option-1",
          "label": "Mr",
          "value": "mr"
        },
        {
          "id": "option-2",
          "label": "Miss",
          "value": "miss"
        },
        {
          "id": "option-3",
          "label": "Ms",
          "value": "ms"
        },
        {
          "id": "option-4",
          "label": "Mrs",
          "value": "mrs"
        },
        {
          "id": "option-5",
          "label": "Dr",
          "value": "dr"
        }
      ],
      "config": {
        "selection": "single",
        "presentation": "dropdown",
        "width": "short"
      },
      "required": {
        "value": true,
        "message": "Title is required"
      }
    },
    {
      "id": "applicant-first-name",
      "type": "question",
      "kind": "text",
      "key": "applicant-first-name",
      "label": "First name",
      "required": {
        "value": true,
        "message": "First name is required"
      },
      "validation": [
        {
          "id": "minLength",
          "type": "minLength",
          "message": "First name must be at least 2 characters",
          "value": 2
        },
        {
          "id": "pattern",
          "type": "pattern",
          "message": "First name must contain only letters, spaces, hyphens, apostrophes, or periods",
          "pattern": "^\\s*\\p{L}(?:[\\p{L}\\p{M}\\s'’.-]*[\\p{L}\\p{M}.])?\\s*$",
          "flags": "u"
        }
      ]
    },
    {
      "id": "applicant-middle-name",
      "type": "question",
      "kind": "text",
      "key": "applicant-middle-name",
      "label": "Middle name",
      "hint": "Provide only if known",
      "validation": [
        {
          "id": "minLength",
          "type": "minLength",
          "message": "Middle name must be at least 2 characters",
          "value": 2
        },
        {
          "id": "pattern",
          "type": "pattern",
          "message": "Middle name must contain only letters, spaces, hyphens, apostrophes, or periods",
          "pattern": "^\\s*\\p{L}(?:[\\p{L}\\p{M}\\s'’.-]*[\\p{L}\\p{M}.])?\\s*$",
          "flags": "u"
        }
      ]
    },
    {
      "id": "applicant-last-name",
      "type": "question",
      "kind": "text",
      "key": "applicant-last-name",
      "label": "Last name",
      "required": {
        "value": true,
        "message": "Last name is required"
      },
      "validation": [
        {
          "id": "minLength",
          "type": "minLength",
          "message": "Last name must be at least 2 characters",
          "value": 2
        },
        {
          "id": "pattern",
          "type": "pattern",
          "message": "Last name must contain only letters, spaces, hyphens, apostrophes, or periods",
          "pattern": "^\\s*\\p{L}(?:[\\p{L}\\p{M}\\s'’.-]*[\\p{L}\\p{M}.])?\\s*$",
          "flags": "u"
        }
      ]
    },
    {
      "id": "address-line-1",
      "type": "question",
      "kind": "text",
      "key": "address-line-1",
      "label": "Address Line 1",
      "required": {
        "value": true,
        "message": "Address line 1 is required"
      },
      "validation": [
        {
          "id": "minLength",
          "type": "minLength",
          "message": "Address must be at least 5 characters",
          "value": 5
        }
      ]
    },
    {
      "id": "address-line-2",
      "type": "question",
      "kind": "text",
      "key": "address-line-2",
      "label": "Address Line 2",
      "required": {
        "value": false,
        "message": ""
      },
      "validation": [
        {
          "id": "minLength",
          "type": "minLength",
          "message": "Address must be at least 5 characters",
          "value": 5
        }
      ]
    },
    {
      "id": "applicant-parish",
      "type": "question",
      "kind": "choice",
      "key": "applicant-parish",
      "label": "Parish",
      "options": [
        {
          "id": "option-1",
          "label": "Christ Church",
          "value": "christ-church"
        },
        {
          "id": "option-2",
          "label": "St. Andrew",
          "value": "st-andrew"
        },
        {
          "id": "option-3",
          "label": "St. George",
          "value": "st-george"
        },
        {
          "id": "option-4",
          "label": "St. James",
          "value": "st-james"
        },
        {
          "id": "option-5",
          "label": "St. John",
          "value": "st-john"
        },
        {
          "id": "option-6",
          "label": "St. Joseph",
          "value": "st-joseph"
        },
        {
          "id": "option-7",
          "label": "St. Lucy",
          "value": "st-lucy"
        },
        {
          "id": "option-8",
          "label": "St. Michael",
          "value": "st-michael"
        },
        {
          "id": "option-9",
          "label": "St. Peter",
          "value": "st-peter"
        },
        {
          "id": "option-10",
          "label": "St. Philip",
          "value": "st-philip"
        },
        {
          "id": "option-11",
          "label": "St. Thomas",
          "value": "st-thomas"
        }
      ],
      "config": {
        "selection": "single",
        "presentation": "dropdown",
        "width": "long"
      },
      "required": {
        "value": true,
        "message": "Parish is required"
      }
    },
    {
      "id": "applicant-postcode",
      "type": "question",
      "kind": "text",
      "key": "applicant-postcode",
      "label": "Postcode",
      "hint": "For example, BB17004",
      "config": {
        "width": "short"
      },
      "validation": [
        {
          "id": "pattern",
          "type": "pattern",
          "message": "Enter a valid postcode (for example, BB17004)",
          "pattern": "^[Bb]{2} ?\\d{5}$",
          "flags": ""
        }
      ]
    },
    {
      "id": "applicant-email",
      "type": "question",
      "kind": "email",
      "key": "applicant-email",
      "label": "Email address",
      "required": {
        "value": true,
        "message": "Email address is required"
      },
      "validation": [
        {
          "id": "email",
          "type": "email",
          "message": "Please enter a valid email address"
        }
      ]
    },
    {
      "id": "applicant-telephone",
      "type": "question",
      "kind": "phone",
      "key": "applicant-telephone",
      "label": "Telephone number",
      "hint": "For example, 421-1234 for Barbados or +1 876 210 1234 for numbers outside Barbados",
      "required": {
        "value": true,
        "message": "Telephone number is required"
      },
      "validation": [
        {
          "id": "phone",
          "type": "phone",
          "message": "Please enter a valid phone number"
        }
      ]
    },
    {
      "id": "page-check-your-answers",
      "type": "page",
      "role": "review",
      "title": "Check your answers",
      "description": "Review all the information you have provided before submitting your application.",
      "review": {
        "questions": "preceding",
        "emptyAnswers": "omit",
        "changeLinks": true
      }
    },
    {
      "id": "page-declaration",
      "type": "page",
      "role": "declaration",
      "title": "Declaration"
    },
    {
      "id": "declaration-applicant",
      "type": "content",
      "kind": "paragraph",
      "content": [
        "Applicant: ",
        {
          "answer": "applicant-first-name"
        },
        " ",
        {
          "answer": "applicant-middle-name",
          "fallback": ""
        },
        " ",
        {
          "answer": "applicant-last-name"
        }
      ]
    },
    {
      "id": "declaration-date",
      "type": "content",
      "kind": "paragraph",
      "content": [
        "Date: ",
        {
          "context": "today",
          "format": {
            "type": "date",
            "style": "short"
          }
        }
      ]
    },
    {
      "id": "declaration-confirmed",
      "type": "question",
      "kind": "choice",
      "key": "declaration-confirmed",
      "label": "Declaration",
      "review": false,
      "options": [
        {
          "id": "option-1",
          "label": "I confirm that my information is correct and I am happy for it to be verified. I understand that false details may lead to my application being rejected, and that the Government of Barbados will keep my information confidential.",
          "value": "confirmed"
        }
      ],
      "config": {
        "selection": "single",
        "presentation": "radio"
      },
      "required": {
        "value": true,
        "message": "You must confirm the declaration to continue"
      }
    },
    {
      "id": "page-submission-confirmation",
      "type": "page",
      "role": "confirmation",
      "title": "Application submitted"
    },
    {
      "id": "confirmation-receipt",
      "type": "content",
      "kind": "paragraph",
      "content": [
        "Your reference: ",
        {
          "context": "submissionReference"
        }
      ]
    },
    {
      "id": "confirmation-next-heading-1",
      "type": "content",
      "kind": "heading",
      "content": "What happens next",
      "config": {
        "level": 2
      }
    },
    {
      "id": "confirmation-next-copy-1",
      "type": "content",
      "kind": "paragraph",
      "content": "We have received your submission. You will receive a confirmation email at the address you provided."
    }
  ]
}
