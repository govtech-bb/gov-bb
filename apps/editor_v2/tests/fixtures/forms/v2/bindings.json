      "default": false
    },
    {
      "id": "date",
      "type": "question",
      "kind": "date",
      "key": "date",
      "label": "Date",
      "default": {
        "context": "today"
      },
      "validation": [
        {
          "id": "past",
          "type": "dateBefore",
          "value": {
            "context": "today"
          },
          "inclusive": true,
          "message": "Use today or before"
        },
        {
          "id": "dates",
          "type": "dateIn",
          "value": [
            "2026-10-04"
          ],
          "message": "Choose an available day"
        }
      ]
    },
    {
      "id": "file",
      "type": "question",
      "kind": "file",
      "key": "file",
      "label": "Files",
      "config": {
        "multiple": true
      },
      "validation": [
        {
          "id": "types",
          "type": "fileTypes",
          "value": [
            "application/pdf"
          ],
          "message": "Upload a PDF"
        },
        {
          "id": "size",
          "type": "maxFileSize",
          "value": 5,
          "unit": "MB",
          "message": "Use 5MB or less"
        }
      ]
    },
    {
      "id": "radio",
      "type": "question",
      "kind": "choice",
      "key": "radio",
      "label": "radio",
      "config": {
        "selection": "single",
        "presentation": "radio",
        "width": "long"
      },
      "options": [
        {
          "id": "zero",
          "value": 0,
          "label": [
