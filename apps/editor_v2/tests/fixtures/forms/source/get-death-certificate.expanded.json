{
  "source": "apps/api/src/forms/form-definitions/recipes/get-death-certificate.json",
  "sha256": "63f4553d8be2b01cda4fe72bd8a0ef6ddc13c073fd7a8d92e60253e840dbf73f",
  "formId": "get-death-certificate",
  "title": "Get a Death Certificate",
  "description": "Apply for a certified copy of a death certificate",
  "processors": [
    {
      "type": "email",
      "config": {
        "recipientField": "applicant-details.applicant-email",
        "subject": "Your death certificate request has been received"
      }
    },
    {
      "type": "email",
      "config": {
        "recipientField": "config.mdaEmail",
        "subject": "Death certificate application submitted."
      }
    }
  ],
  "steps": [
    {
      "stepId": "applicant-details",
      "title": "Tell us about yourself",
      "elements": [
        {
          "ref": "components/title",
          "fieldId": "applicant-title",
          "htmlType": "select",
          "label": "Title",
          "options": [
            {
              "label": "Mr",
              "value": "mr"
            },
            {
              "label": "Miss",
              "value": "miss"
            },
            {
              "label": "Ms",
              "value": "ms"
            },
            {
              "label": "Mrs",
              "value": "mrs"
            },
            {
              "label": "Dr",
              "value": "dr"
            }
          ],
          "multiple": false,
          "validations": {
            "required": {
              "error": "Title is required",
              "value": true
            }
          },
          "ui": {
            "width": "short"
          }
        },
        {
          "ref": "components/first-name",
          "fieldId": "applicant-first-name",
          "label": "First name",
          "htmlType": "text",
          "validations": {
            "required": {
              "error": "First name is required",
              "value": true
            },
            "minLength": {
              "error": "First name must be at least 2 characters",
              "value": 2
            },
            "pattern": {
              "value": "^\\s*\\p{L}(?:[\\p{L}\\p{M}\\s'’.-]*[\\p{L}\\p{M}.])?\\s*$",
              "error": "First name must contain only letters, spaces, hyphens, apostrophes, or periods"
            }
          }
        },
        {
          "ref": "components/middle-name",
          "fieldId": "applicant-middle-name",
          "label": "Middle name",
          "htmlType": "text",
          "hint": "Provide only if known",
          "validations": {
            "minLength": {
              "value": 2,
              "error": "Middle name must be at least 2 characters"
            },
            "pattern": {
              "value": "^\\s*\\p{L}(?:[\\p{L}\\p{M}\\s'’.-]*[\\p{L}\\p{M}.])?\\s*$",
              "error": "Middle name must contain only letters, spaces, hyphens, apostrophes, or periods"
            }
          }
        },
        {
          "ref": "components/last-name",
          "fieldId": "applicant-last-name",
          "label": "Last name",
          "htmlType": "text",
          "validations": {
            "required": {
              "error": "Last name is required",
              "value": true
            },
            "minLength": {
              "error": "Last name must be at least 2 characters",
              "value": 2
            },
            "pattern": {
              "value": "^\\s*\\p{L}(?:[\\p{L}\\p{M}\\s'’.-]*[\\p{L}\\p{M}.])?\\s*$",
              "error": "Last name must contain only letters, spaces, hyphens, apostrophes, or periods"
            }
          }
        },
        {
          "ref": "components/address",
          "fieldId": "applicant-address-line-1",
          "htmlType": "text",
          "label": "Address Line 1",
          "validations": {
            "required": {
              "error": "Address line 1 is required",
              "value": true
            },
            "minLength": {
              "error": "Address must be at least 5 characters",
              "value": 5
            }
          }
        },
        {
          "ref": "components/address",
          "fieldId": "applicant-address-line-2",
          "htmlType": "text",
          "label": "Address Line 2",
          "validations": {
            "required": {
              "value": false
            },
            "minLength": {
              "value": 5,
              "error": "Address must be at least 5 characters"
            }
          }
        },
        {
          "ref": "components/parish",
          "fieldId": "applicant-parish",
          "label": "Parish",
          "htmlType": "select",
          "options": [
            {
              "label": "Christ Church",
              "value": "christ-church"
            },
            {
              "label": "St. Andrew",
              "value": "st-andrew"
            },
            {
              "label": "St. George",
              "value": "st-george"
            },
            {
              "label": "St. James",
              "value": "st-james"
            },
            {
              "label": "St. John",
              "value": "st-john"
            },
            {
              "label": "St. Joseph",
              "value": "st-joseph"
            },
            {
              "label": "St. Lucy",
              "value": "st-lucy"
            },
            {
              "label": "St. Michael",
              "value": "st-michael"
            },
            {
              "label": "St. Peter",
              "value": "st-peter"
            },
            {
              "label": "St. Philip",
              "value": "st-philip"
            },
            {
              "label": "St. Thomas",
              "value": "st-thomas"
            }
          ],
          "multiple": false,
          "validations": {
            "required": {
              "error": "Parish is required",
              "value": true
            }
          },
          "ui": {
            "width": "long"
          }
        },
        {
          "ref": "components/postcode",
          "fieldId": "applicant-postcode",
          "label": "Postcode",
          "htmlType": "text",
          "hint": "For example, BB17004",
          "validations": {
            "pattern": {
              "value": "^[Bb]{2} ?\\d{5}$",
              "error": "Enter a valid postcode (for example, BB17004)"
            }
          },
          "ui": {
            "width": "short"
          }
        },
        {
          "ref": "components/national-id-number",
          "fieldId": "applicant-id-number",
          "label": "National Identification (ID) Number",
          "htmlType": "text",
          "mask": "999999-9999",
          "placeholder": "for example, 850101-0001",
          "behaviours": [
            {
              "type": "optionalIf",
              "targetFieldId": "passport-toggle",
              "operator": "equal",
              "value": true
            }
          ],
          "validations": {
            "pattern": {
              "value": "^\\d{6}-\\d{4}$",
              "error": "Enter a valid National ID number (for example, 850101-0001)"
            },
            "required": {
              "error": "ID Number is required",
              "value": true
            }
          },
          "ui": {
            "width": "medium"
          }
        },
        {
          "ref": "components/show-hide",
          "fieldId": "passport-toggle",
          "htmlType": "show-hide",
          "label": "Use passport number instead",
          "hint": "If you don't have a National ID number, you can use your passport number instead."
        },
        {
          "ref": "components/passport-number",
          "fieldId": "applicant-passport-number",
          "label": "Passport Number",
          "htmlType": "text",
          "behaviours": [
            {
              "type": "fieldConditionalOn",
              "targetFieldId": "passport-toggle",
              "operator": "equal",
              "value": true
            }
          ],
          "validations": {
            "minLength": {
              "error": "Passport number must be at least 6 characters",
              "value": 6
            },
            "required": {
              "error": "Passport number is required",
              "value": true
            }
          },
          "ui": {
            "width": "short"
          }
        },
        {
          "ref": "components/email",
          "fieldId": "applicant-email",
          "htmlType": "email",
          "label": "Email address",
          "validations": {
            "required": {
              "error": "Email address is required",
              "value": true
            },
            "email": {
              "value": true,
              "error": "Please enter a valid email address"
            }
          }
        },
        {
          "ref": "components/telephone",
          "fieldId": "applicant-telephone",
          "label": "Telephone number",
          "htmlType": "tel",
          "hint": "For example, 421-1234 for Barbados or +1 876 210 1234 for numbers outside Barbados",
          "validations": {
            "required": {
              "error": "Telephone number is required",
              "value": true
            },
            "phone": {
              "value": true,
              "error": "Please enter a valid phone number"
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "relationship-to-person",
      "title": "Tell us your relationship with the deceased",
      "description": "For example, spouse, child, parent, sibling, executor, or authorised representative.",
      "elements": [
        {
          "ref": "components/relationship",
          "fieldId": "relationship",
          "htmlType": "select",
          "label": "Relationship",
          "options": [
            {
              "label": "Spouse",
              "value": "spouse"
            },
            {
              "label": "Parent",
              "value": "parent"
            },
            {
              "label": "Child",
              "value": "child"
            },
            {
              "label": "Sibling",
              "value": "sibling"
            },
            {
              "label": "Grandparent",
              "value": "grandparent"
            },
            {
              "label": "Grandchild",
              "value": "grandchild"
            },
            {
              "label": "Friend",
              "value": "friend"
            },
            {
              "label": "Legal guardian",
              "value": "legal-guardian"
            },
            {
              "label": "Legal representive",
              "value": "legal-representive"
            },
            {
              "label": "Colleague",
              "value": "colleague"
            },
            {
              "label": "Other (please describe)",
              "value": "other"
            }
          ],
          "multiple": false,
          "validations": {
            "required": {
              "value": true,
              "error": "Relationship is required"
            }
          }
        },
        {
          "ref": "components/name",
          "fieldId": "relationship-other-description",
          "label": "Please describe your relationship",
          "htmlType": "text",
          "behaviours": [
            {
              "type": "fieldConditionalOn",
              "targetFieldId": "relationship",
              "operator": "equal",
              "value": "other"
            }
          ],
          "validations": {
            "required": {
              "error": "Please describe your relationship",
              "value": true
            },
            "minLength": {
              "error": "Please provide at least 2 characters",
              "value": 2
            },
            "pattern": {
              "value": "^\\s*\\p{L}(?:[\\p{L}\\p{M}\\s'’.-]*[\\p{L}\\p{M}.])?\\s*$",
              "error": "Name must contain only letters, spaces, hyphens, apostrophes, or periods"
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "reason-for-certificate",
      "title": "Tell us about why you need this certificate",
      "description": "Give the reason in a short sentence.",
      "elements": [
        {
          "ref": "components/name",
          "fieldId": "reason-for-certificate",
          "label": "Reason for requesting the certificate",
          "htmlType": "text",
          "validations": {
            "required": {
              "error": "Reason is required",
              "value": true
            },
            "minLength": {
              "error": "Please provide at least 10 characters",
              "value": 10
            },
            "pattern": {
              "value": "^\\s*\\p{L}(?:[\\p{L}\\p{M}\\s'’.-]*[\\p{L}\\p{M}.])?\\s*$",
              "error": "Name must contain only letters, spaces, hyphens, apostrophes, or periods"
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "deceased-details",
      "title": "Tell us about the deceased",
      "description": "Provide as much information as you can to help us find the correct record.",
      "elements": [
        {
          "ref": "components/first-name",
          "fieldId": "deceased-first-name",
          "label": "First name",
          "htmlType": "text",
          "validations": {
            "required": {
              "error": "First name is required",
              "value": true
            },
            "minLength": {
              "error": "First name must be at least 2 characters",
              "value": 2
            },
            "pattern": {
              "value": "^\\s*\\p{L}(?:[\\p{L}\\p{M}\\s'’.-]*[\\p{L}\\p{M}.])?\\s*$",
              "error": "First name must contain only letters, spaces, hyphens, apostrophes, or periods"
            }
          }
        },
        {
          "ref": "components/middle-name",
          "fieldId": "deceased-middle-name",
          "label": "Middle name",
          "htmlType": "text",
          "hint": "Leave blank if not known",
          "validations": {
            "minLength": {
              "value": 2,
              "error": "Middle name must be at least 2 characters"
            },
            "pattern": {
              "value": "^\\s*\\p{L}(?:[\\p{L}\\p{M}\\s'’.-]*[\\p{L}\\p{M}.])?\\s*$",
              "error": "Middle name must contain only letters, spaces, hyphens, apostrophes, or periods"
            }
          }
        },
        {
          "ref": "components/last-name",
          "fieldId": "deceased-last-name",
          "label": "Last name",
          "htmlType": "text",
          "validations": {
            "required": {
              "error": "Last name is required",
              "value": true
            },
            "minLength": {
              "error": "Last name must be at least 2 characters",
              "value": 2
            },
            "pattern": {
              "value": "^\\s*\\p{L}(?:[\\p{L}\\p{M}\\s'’.-]*[\\p{L}\\p{M}.])?\\s*$",
              "error": "Last name must contain only letters, spaces, hyphens, apostrophes, or periods"
            }
          }
        },
        {
          "ref": "components/generic-radio",
          "fieldId": "deceased-known-date-of-death",
          "htmlType": "radio",
          "label": "Do you know the date the person died?",
          "options": [
            {
              "label": "Yes",
              "value": "yes"
            },
            {
              "label": "No",
              "value": "no"
            }
          ],
          "validations": {
            "required": {
              "error": "Whether date of death is known is required",
              "value": true
            }
          }
        },
        {
          "ref": "components/generic-date",
          "fieldId": "deceased-date-of-death",
          "htmlType": "date",
          "label": "Date of death",
          "behaviours": [
            {
              "type": "fieldConditionalOn",
              "targetFieldId": "deceased-known-date-of-death",
              "operator": "equal",
              "value": "yes"
            }
          ],
          "validations": {
            "required": {
              "value": true
            }
          }
        },
        {
          "ref": "components/generic-text",
          "fieldId": "deceased-estimated-date-of-death",
          "htmlType": "text",
          "label": "Provide the two-year search range you want us to check",
          "hint": "Enter a 2-year period, for example 1990 to 1991. If you are not sure, give your best estimate.",
          "behaviours": [
            {
              "type": "fieldConditionalOn",
              "targetFieldId": "deceased-known-date-of-death",
              "targetStepId": "deceased-details",
              "operator": "equal",
              "value": "no"
            }
          ],
          "validations": {
            "required": {
              "error": "Estimate is required",
              "value": true
            }
          }
        },
        {
          "ref": "components/national-id-number",
          "fieldId": "deceased-id-number",
          "label": "National Identification (ID) Number",
          "htmlType": "text",
          "mask": "999999-9999",
          "hint": "Enter only if known",
          "validations": {
            "pattern": {
              "value": "^\\d{6}-\\d{4}$",
              "error": "Enter a valid National ID number (for example, 850101-0001)"
            }
          },
          "ui": {
            "width": "medium"
          }
        },
        {
          "ref": "components/generic-text",
          "fieldId": "deceased-place-of-death",
          "htmlType": "text",
          "label": "Place of death",
          "hint": "Enter the location where the person died. If you do not know the exact address, provide the town, city, or country.",
          "validations": {
            "required": {
              "error": "Place of death is required",
              "value": true
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "order-details",
      "title": "How many copies do you need?",
      "description": "Each copy costs $5.00 BBD for a certificate",
      "elements": [
        {
          "ref": "components/generic-number",
          "fieldId": "number-of-copies",
          "htmlType": "number",
          "label": "Number of copies",
          "validations": {
            "required": {
              "error": "Number of copies is required",
              "value": true
            },
            "min": {
              "value": 0,
              "error": "This field must be greater than or equal to 0"
            }
          },
          "ui": {
            "width": "short"
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "check-your-answers",
      "title": "Check your answers",
      "description": "Review all the information you have provided before submitting your application.",
      "elements": [],
      "behaviours": []
    },
    {
      "stepId": "declaration",
      "title": "Declaration",
      "elements": [
        {
          "ref": "components/confirmation",
          "fieldId": "declaration-confirmed",
          "htmlType": "checkbox",
          "label": "Declaration",
          "options": [
            {
              "label": "I confirm that my information is correct and I am happy for it to be verified. I understand that false details may lead to my application being rejected, and that the Government of Barbados will keep my information confidential.",
              "value": "confirmed"
            }
          ],
          "validations": {
            "required": {
              "error": "You must confirm the declaration to continue",
              "value": true
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "submission-confirmation",
      "title": "Application submitted",
      "elements": [],
      "behaviours": [],
      "markdownContent": "## What happens next\n\nYou will receive a confirmation email with:\n\n- your application reference number\n- the cost of the certificate(s)\n- the expected completion date"
    }
