{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["node", "vite/client"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    // block-kit's source, as vite.config.ts aliases it: no prior build needed
    "paths": { "@govtech-bb/block-kit/contact": ["../../packages/block-kit/src/contact.ts"] }
  },
  "include": ["*.config.ts", "src/**/*", "tests/**/*", "scripts/**/*", "docs/examples/**/*"],
  "exclude": ["node_modules", "reference", "plans", "dist", "out"]
}
