{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "module": "commonjs",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    // DOM types: @govtech-bb/umami-analytics re-exports @govtech-bb/analytics,
    // whose browser helpers reference `window`, and the nx build compiles that
    // source inside this program (#3491). Nothing here calls them at runtime.
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"],
    "preserveWatchOutput": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@govtech-bb/form-types": ["../../packages/form-types/src/index.ts"],
      "@govtech-bb/expressions": ["../../packages/expressions/src/index.ts"],
      "@govtech-bb/form-conditions": [
        "../../packages/form-conditions/src/index.ts"
      ],
      "@govtech-bb/form-validation": [
        "../../packages/form-validation/src/index.ts"
      ],
      "@govtech-bb/registry": ["../../packages/registry/src/index.ts"],
      "@govtech-bb/submission-summary": [
        "../../packages/submission-summary/src/index.ts"
      ],
      "@govtech-bb/database": ["../../packages/database/src/index.ts"],
      "@govtech-bb/umami-analytics": [
        "../../packages/umami-analytics/src/index.ts"
      ]
    }
  },
  "references": [
    {
      "path": "../../packages/database"
    },
    {
      "path": "../../packages/form-builder"
    },
    {
      "path": "../../packages/form-types"
    },
    {
      "path": "../../packages/form-validation"
    },
    {
      "path": "../../packages/form-conditions"
    },
    {
      "path": "../../packages/registry"
    },
    {
      "path": "../../packages/submission-summary"
    },
    {
      "path": "../../packages/umami-analytics"
    },
    {
      "path": "../../packages/analytics"
    }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
