{
  "formId": "register-guest-property-environmental-health",
  "title": "Register a guest property with Environmental Health",
  "description": "Register a lodging house or barracks with Environmental Health",
  "processors": [
    {
      "type": "email",
      "config": {
        "recipientField": "your-details.applicant-contact-number",
        "subject": "Your application to register a guest property has been received"
      }
    }
  ],
  "meta": {
    "visibility": "preview"
  },
  "steps": [
    {
      "stepId": "your-details",
      "title": "Your details",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "is-property-owner",
            "label": "Are you the property owner?",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Choose yes if you are the property owner."
              }
            }
          }
        },
        {
          "ref": "components/first-name",
          "overrides": {
            "fieldId": "applicant-first-name",
            "label": "First name"
          }
        },
        {
          "ref": "components/middle-name",
          "overrides": {
            "fieldId": "applicant-middle-name",
            "label": "Middle name",
            "hint": "Leave this blank if you do not have a middle name."
          }
        },
        {
          "ref": "components/last-name",
          "overrides": {
            "fieldId": "applicant-last-name",
            "label": "Last name"
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "applicant-role-owner",
            "label": "What is your role at the property?",
            "options": [
              {
                "label": "Manager",
                "value": "manager"
              },
              {
                "label": "Attorney",
                "value": "attorney"
              },
              {
                "label": "Another role",
                "value": "another-role"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Choose your role at the property."
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "applicant-role-other",
            "label": "What is your role at the property?",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter your role at the property."
              }
            }
          }
        },
        {
          "ref": "components/contact-telephone",
          "overrides": {
            "fieldId": "applicant-contact-number",
            "label": "What is your contact number?",
            "hint": "You can enter a local or international number.",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter a contact number."
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "owner-details",
      "title": "Property owner details",
      "elements": [
        {
          "ref": "components/name",
          "overrides": {
            "fieldId": "owner-full-name",
            "label": "Who owns the property?",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the property owner's full name."
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "owner-address-line-1",
            "label": "Address line 1",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the property owner's address."
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "owner-address-line-2",
            "label": "Address line 2",
            "hint": "Optional."
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "owner-parish",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the property owner's address."
              }
            }
          }
        }
      ],
      "behaviours": [
        {
          "type": "stepConditionalOn",
          "targetStepId": "your-details",
          "targetFieldId": "is-property-owner",
          "operator": "equal",
          "value": "no"
        }
      ]
    },
    {
      "stepId": "property-details",
      "title": "Property details",
      "elements": [
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "property-address-line-1",
            "label": "Address line 1",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the property address."
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "property-address-line-2",
            "label": "Address line 2",
            "hint": "Optional."
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "property-parish",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the property address."
              }
            }
          }
        },
        {
          "ref": "components/generic-number",
          "overrides": {
            "fieldId": "property-number-of-rooms",
            "label": "How many rooms does the property have?",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the number of rooms."
              },
              "min": {
                "value": 1,
                "error": "Enter a number greater than 0."
              }
            }
          }
        },
        {
          "ref": "components/generic-number",
          "overrides": {
            "fieldId": "property-number-of-occupants",
            "label": "How many people can stay at the property at one time?",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the number of people who can stay at the property at one time."
              },
              "min": {
                "value": 1,
                "error": "Enter a number greater than 0."
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "check-your-answers",
      "title": "Check your answers",
      "description": "Review all the information you have provided before you submit your application.",
      "elements": [],
      "behaviours": []
    },
    {
      "stepId": "declaration",
      "title": "Declaration",
      "elements": [
        {
          "ref": "components/confirmation",
          "overrides": {
            "fieldId": "declaration-confirmed",
            "label": "Declaration",
            "options": [
              {
                "label": "I confirm that the information I have provided is correct.",
                "value": "confirmed"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "You must confirm the declaration to continue."
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "submission-confirmation",
      "title": "Application submitted",
      "elements": [],
      "behaviours": [],
      "nextSteps": [
        {
          "title": "What happens next",
          "content": "Your application has been sent to Environmental Health.\n\nEnvironmental Health will review your application. They may contact you if they need more information.\n\nSubmitting the application does not mean the property has been registered."
        }
      ]
    }
  ],
  "createdAt": "2026-08-18T13:18:49.244Z",
  "updatedAt": "2026-08-18T13:18:49.244Z"
}
