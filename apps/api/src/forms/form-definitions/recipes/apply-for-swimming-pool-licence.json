  "processors": [
    {
      "type": "email",
      "config": {
        "recipientField": "your-details.email",
        "subject": "Your application for a swimming pool licence has been received"
      }
    },
    {
      "type": "email",
      "config": {
        "recipientField": "catchment.mdaEmail",
        "subject": "A new application for a swimming pool licence has been received"
      }
    },
    {
      "type": "webhook",
      "config": {
        "method": "POST",
        "signatureHeader": "X-Webhook-Signature",
        "mapping": {
          "programmeCode": "SWIMMING_POOL_LICENCE",
          "mdaCode": "MOH",
          "programmeShortCode": "SPL",
          "applicant": {
            "name": [
              "your-details.first-name",
              "your-details.last-name"
            ],
            "email": "your-details.email",
            "phone": "your-details.telephone"
          },
          "excludeSteps": [
            "check-your-answers",
            "declaration",
            "submission-confirmation"
          ],
          "groupByStep": true
        },
        "timeoutMs": 10000
      }
    }
