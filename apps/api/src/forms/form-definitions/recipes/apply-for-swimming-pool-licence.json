            "validations": {
              "required": {
                "value": true,
                "error": "Upload the Town and Country Planning Site Plan"
              },
              "fileTypes": {
                "error": "Upload a file in PDF, JPEG, PNG, Word or Excel format",
                "value": [
                  "application/pdf",
                  "image/jpeg",
                  "image/png",
                  ".doc",
                  ".docx",
                  ".xls",
                  ".xlsx"
                ]
              },
              "itemMaxSize": {
                "value": 5242880,
                "error": "Each file must be 5 MB or smaller"
              }
            }
          }
        },
        {
          "ref": "components/upload-document",
          "overrides": {
            "label": "Pool Plan",
            "fieldId": "pool-plan",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "renewal",
                "operator": "equal",
                "targetStepId": "about-application",
                "targetFieldId": "application-type"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Upload the Pool Plan"
              },
              "fileTypes": {
                "error": "Upload a file in PDF, JPEG, PNG, Word or Excel format",
                "value": [
                  "application/pdf",
                  "image/jpeg",
                  "image/png",
                  ".doc",
                  ".docx",
                  ".xls",
                  ".xlsx"
                ]
              },
              "itemMaxSize": {
                "value": 5242880,
                "error": "Each file must be 5 MB or smaller"
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "label": "Town and Country Planning Application Number",
            "fieldId": "town-text",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "new",
                "operator": "equal",
                "targetStepId": "about-application",
                "targetFieldId": "application-type"
              }
            ],
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        }
