{
  "formId": "apply-for-swimming-pool-licence",
  "title": "Apply for a swimming pool licence with Environmental Health",
  "description": "Apply to Environmental Health for a swimming or wading pool permit",
  "processors": [
    {
      "type": "email",
      "config": {
        "subject": "Your swimming or wading pool permit application has been received",
        "recipientField": "your-details.email"
      }
    },
    {
      "type": "email",
      "config": {
        "subject": "A new swimming or wading pool permit application has been received",
        "recipientField": "catchment.mdaEmail"
      }
    },
    {
      "type": "webhook",
      "config": {
        "mapping": {
          "mdaCode": "MOH",
          "programmeShortCode": "SPP",
          "programmeCode": "SWIMMING_POOL_PERMIT",
          "applicant": {
            "name": [
              "your-details.first-name",
              "your-details.last-name"
            ],
            "email": "your-details.email",
            "phone": "your-details.mobile-telephone"
          },
          "excludeSteps": [
            "check-your-answers",
            "declaration",
            "submission-confirmation"
          ],
          "groupByStep": true
        }
      }
    }
  ],
  "meta": {
    "visibility": "preview"
  },
  "steps": [
    {
      "stepId": "about-application",
      "title": "About your application",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "label": "Is this a new application or a renewal?",
            "fieldId": "application-type",
            "options": [
              {
                "label": "New application",
                "value": "new"
              },
              {
                "label": "Renewal",
                "value": "renewal"
              }
            ],
            "validations": {
              "required": {
                "value": true
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "your-details",
      "title": "Your details",
      "elements": [
        {
          "ref": "components/first-name"
        },
        {
          "ref": "components/middle-name"
        },
        {
          "ref": "components/last-name"
        },
        {
          "ref": "components/address-lookup",
          "overrides": {
            "label": "Address line 1",
            "fieldId": "your-address-line-1",
            "validations": {
              "required": {
                "error": "Enter your address",
                "value": true
              }
            },
            "hint": "Start typing your address and choose it from the list.",
            "geocodeTargets": {
              "line2FieldId": "your-address-line-2",
              "parishFieldId": "parish",
              "coordinatesFieldId": "your-address-coordinates"
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 2",
            "fieldId": "your-address-line-2",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish"
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "your-address-coordinates",
            "label": "Home address coordinates",
            "validations": {
              "required": {
                "value": false
              }
            },
            "ui": {
              "hidden": true
            }
          }
        },
        {
          "ref": "components/email"
        },
        {
          "ref": "components/mobile-telephone"
        },
        {
          "ref": "components/work-telephone"
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "pool-location",
      "title": "Where is the pool?",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "pool-same-address",
            "label": "Is the pool at the address you just gave us?",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Select an option"
              }
            }
          }
        },
        {
          "ref": "components/address-lookup",
          "overrides": {
            "fieldId": "pool-address-line-1",
            "label": "Address line 1",
            "hint": "Start typing the address and choose it from the list. If you are applying for more than one pool, give the address of the property they are on.",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the address where the pool is"
              }
            },
            "geocodeTargets": {
              "line2FieldId": "pool-address-line-2",
              "parishFieldId": "pool-parish",
              "coordinatesFieldId": "pool-address-coordinates"
            },
            "behaviours": [
              {
                "type": "copyFrom",
                "operator": "equal",
                "value": "yes",
                "targetFieldId": "pool-same-address",
                "sourceStepId": "your-details",
                "sourceFieldId": "your-address-line-1"
              }
            ]
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "pool-address-line-2",
            "label": "Address line 2",
            "validations": {
              "required": {
                "value": false
              }
            },
            "behaviours": [
              {
                "type": "copyFrom",
                "operator": "equal",
                "value": "yes",
                "targetFieldId": "pool-same-address",
                "sourceStepId": "your-details",
                "sourceFieldId": "your-address-line-2"
              }
            ]
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "pool-parish",
            "label": "Parish",
            "validations": {
              "required": {
                "value": true,
                "error": "Select the parish where the pool is"
              }
            },
            "behaviours": [
              {
                "type": "copyFrom",
                "operator": "equal",
                "value": "yes",
                "targetFieldId": "pool-same-address",
                "sourceStepId": "your-details",
                "sourceFieldId": "parish"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "pool-address-coordinates",
            "label": "Pool location coordinates",
            "validations": {
              "required": {
                "value": false
              }
            },
            "ui": {
              "hidden": true
            },
            "behaviours": [
              {
                "type": "copyFrom",
                "operator": "equal",
                "value": "yes",
                "targetFieldId": "pool-same-address",
                "sourceStepId": "your-details",
                "sourceFieldId": "your-address-coordinates"
              }
            ]
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "pool-details",
      "title": "Pool details and maintenance",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "label": "Which best describes your application?",
            "fieldId": "owner-type",
            "options": [
              {
                "label": "I own the pool for a business or property",
                "value": "business-owner"
              },
              {
                "label": "I manage or operate the pool for someone else",
                "value": "manager"
              }
            ],
            "validations": {
              "required": {
                "error": "Select an option",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "hint": "For example, manager, employee or authorised representative.",
            "label": "How are you connected to the pool?",
            "fieldId": "connection-to-pool",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "manager",
                "operator": "equal",
                "targetFieldId": "owner-type"
              }
            ],
            "validations": {
              "required": {
                "error": "Enter how you are connected to the pool",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "label": "What type of pool is it?",
            "fieldId": "pool-type",
            "options": [
              {
                "label": "Swimming pool",
                "value": "swimming"
              },
              {
                "label": "Wading pool",
                "value": "wading"
              },
              {
                "label": "Jacuzzi/Hot tub",
                "value": "jacuzzi"
              }
            ],
            "validations": {
              "required": {
                "error": "Select a pool type",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "hint": "If the pool does not have a formal name, enter a simple description, such as home pool or hotel pool.",
            "label": "What is the name of the pool?",
            "fieldId": "pool-name",
            "validations": {
              "required": {
                "error": "Enter the name of the pool",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-number",
          "overrides": {
            "label": "How much water can the pool hold?",
            "fieldId": "pool-water-capacity-number",
            "validations": {
              "gt": {
                "error": "Enter a value greater than 0",
                "value": 0
              },
              "required": {
                "error": "Enter the water capacity",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-select",
          "overrides": {
            "ui": {
              "width": "short"
            },
            "label": "What unit is this measured in?",
            "fieldId": "pool-capacity-unit",
            "options": [
              {
                "label": "Gallons",
                "value": "gallons"
              },
              {
                "label": "Cubic metres",
                "value": "cubic-metres"
              }
            ],
            "validations": {
              "required": {
                "error": "Select a unit",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-checkbox",
          "overrides": {
            "label": "How is the pool mainly used?",
            "fieldId": "pool-usage-type",
            "options": [
              {
                "label": "By guests at a hotel or other accommodation",
                "value": "hotel"
              },
              {
                "label": "By residents of an apartment building or residential complex",
                "value": "apartment"
              },
              {
                "label": "By members of the public",
                "value": "public"
              },
              {
                "label": "Condominiums",
                "value": "condo-home"
              },
              {
                "label": "School",
                "value": "school"
              },
              {
                "label": "Other",
                "value": "other"
              }
            ],
            "validations": {
              "required": {
                "error": "Select how the pool is mainly used",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "label": "Describe how is the pool mainly used",
            "fieldId": "other-pool",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": [
                  "other"
                ],
                "operator": "in",
                "targetStepId": "pool-details",
                "targetFieldId": "pool-usage-type"
              }
            ],
            "validations": {
              "required": {
                "value": true
              }
            }
          }
        }
      ],
      "behaviours": [
        {
          "max": 5000,
          "min": 1,
          "type": "repeatable",
          "addAnotherLabel": "Do you want to add another pool?"
        }
      ]
