  "processors": [
    {
      "type": "email",
      "config": {
        "recipientField": "your-details.applicant-email",
        "subject": "Your lodging house or barracks licence application has been received"
      }
    },
    {
      "type": "email",
      "config": {
        "recipientField": "catchment.mdaEmail",
        "subject": "A new lodging house or barracks licence application has been received"
      }
    },
    {
      "type": "webhook",
      "config": {
        "method": "POST",
        "signatureHeader": "X-Webhook-Signature",
        "mapping": {
          "programmeCode": "LODGING_BARRACKS_LICENCE",
          "mdaCode": "MOH",
          "programmeShortCode": "LBL",
          "applicant": {
            "name": [
              "your-details.applicant-first-name",
              "your-details.applicant-last-name"
            ],
            "email": "your-details.applicant-email",
            "phone": "your-details.applicant-contact-number"
          },
          "excludeSteps": [
            "check-your-answers",
            "declaration",
            "submission-confirmation"
          ],
          "groupByStep": true
        },
        "timeoutMs": 10000
      }
    }
