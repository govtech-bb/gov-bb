{
  "formId": "apply-for-lodging-barracks-licence",
  "title": "Apply for a lodging house or barracks licence with Environmental Health",
  "description": "Register a lodging house or barracks with Environmental Health",
  "steps": [
    {
      "stepId": "application-type",
      "title": "Are you applying for a new licence or renewing one?",
      "behaviours": [],
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "application-type",
            "label": "Are you applying for a new licence or renewing one?",
            "validations": {
              "required": {
                "error": "Select whether you are applying for a new licence or renewing one.",
                "value": true
              }
            },
            "options": [
              {
                "label": "New licence",
                "value": "new-licence"
              },
              {
                "label": "Renew a licence",
                "value": "renew-licence"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "licence-number",
            "label": "Lodging house or barracks licence number",
            "hint": "You can find this on your current licence.",
            "validations": {
              "required": {
                "error": "Lodging house or barracks licence number is required",
                "value": true
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "application-type",
                "targetStepId": "application-type",
                "operator": "equal",
                "value": "renew-licence"
              }
            ],
            "ui": {
              "width": "short"
            }
          }
        }
      ]
    },
    {
      "stepId": "your-details",
      "title": "Your details",
      "behaviours": [],
      "elements": [
        {
          "ref": "components/first-name",
          "overrides": {
            "fieldId": "applicant-first-name",
            "label": "First name"
          }
        },
        {
          "ref": "components/middle-name",
          "overrides": {
            "fieldId": "applicant-middle-name",
            "label": "Middle name",
            "hint": "Enter all middle names in order.",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/last-name",
          "overrides": {
            "fieldId": "applicant-last-name",
            "label": "Last name"
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "address-line-1",
            "label": "Address line 1"
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "address-line-2",
            "label": "Address line 2",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "address-parish"
          }
        },
        {
          "ref": "components/email",
          "overrides": {
            "fieldId": "applicant-email",
            "label": "Email address"
          }
        },
        {
          "ref": "components/telephone",
          "overrides": {
            "fieldId": "applicant-contact-number"
          }
        }
      ]
    },
    {
