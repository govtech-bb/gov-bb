            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "is-property-owner",
                "targetStepId": "property-owner-details",
                "operator": "equal",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "owner-address-line-2",
            "label": "Property owner's address line 2",
            "validations": {
              "required": {
                "value": false
              }
