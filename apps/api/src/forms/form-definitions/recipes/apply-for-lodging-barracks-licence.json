        {
          "ref": "components/generic-number",
          "overrides": {
            "fieldId": "property-number-of-rooms",
            "label": "How many barracks or lodging units does the property have?",
            "validations": {
              "required": {
                "error": "Enter the number of barracks or lodging units.",
                "value": true
              },
              "min": {
                "error": "Enter a number greater than 0.",
                "value": 1
              }
            }
          }
        },
        {
          "ref": "components/generic-number",
          "overrides": {
            "fieldId": "property-number-of-occupants",
            "label": "How many person can stay on the property at one time?",
