        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "is-property-owner",
            "label": "Are you the property owner?",
            "validations": {
              "required": {
                "error": "Choose whether you are the property owner.",
                "value": true
              }
            },
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/name",
          "overrides": {
            "fieldId": "owner-full-name",
            "label": "Full name of property owner",
            "validations": {
              "required": {
                "error": "Enter the property owner's full name.",
                "value": true
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "is-property-owner",
                "targetStepId": "property-owner-details",
                "operator": "equal",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "applicant-role-owner",
            "label": "What is your role at the property?",
            "validations": {
              "required": {
                "error": "Choose your role at the property.",
                "value": true
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "is-property-owner",
                "targetStepId": "property-owner-details",
                "operator": "equal",
                "value": "no"
              }
            ],
            "options": [
              {
                "label": "Manager",
                "value": "manager"
              },
              {
                "label": "Attorney",
                "value": "attorney"
              },
              {
                "label": "Other",
                "value": "other-role"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "applicant-role-other",
            "label": "Describe your role at the property",
            "validations": {
              "required": {
                "error": "Enter your role at the property.",
                "value": true
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "applicant-role-owner",
                "targetStepId": "property-owner-details",
                "operator": "equal",
                "value": "other-role"
              }
            ]
          }
        }
      ]
    },
    {
