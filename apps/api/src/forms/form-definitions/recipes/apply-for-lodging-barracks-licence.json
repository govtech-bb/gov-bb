            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "is-property-owner",
                "targetStepId": "property-owner-details",
                "operator": "equal",
                "value": "no"
              },
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "owner-type",
                "targetStepId": "property-owner-details",
                "operator": "equal",
                "value": "person"
              }
            ]
          }
        },
        {
          "ref": "components/last-name",
          "overrides": {
            "fieldId": "owner-last-name",
            "label": "Property owner's last name",
            "validations": {
              "required": {
                "error": "Property owner's last name is required",
                "value": true
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "is-property-owner",
                "targetStepId": "property-owner-details",
                "operator": "equal",
                "value": "no"
              },
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "owner-type",
                "targetStepId": "property-owner-details",
                "operator": "equal",
                "value": "person"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "owner-business-name",
