{
  "formId": "apply-for-hairdresser-licence",
  "title": "Apply to Environmental Health for a Hairdressers Licence",
  "description": "Apply for a hairdresser licence in Barbados",
  "steps": [
    {
      "stepId": "personal-details",
      "title": "Tell us about yourself",
      "behaviours": [],
      "elements": [
        {
          "ref": "components/first-name",
          "overrides": {
            "fieldId": "first-name",
            "validations": {
              "required": {
                "error": "Enter your first name",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/middle-name",
          "overrides": {
            "fieldId": "middle-name",
            "label": "Middle name or names",
            "hint": "Enter all middle names in order."
          }
        },
        {
          "ref": "components/last-name",
          "overrides": {
            "fieldId": "last-name",
            "validations": {
              "required": {
                "error": "Enter your last name",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/national-id-number",
          "overrides": {
            "fieldId": "national-id-number",
            "validations": {
              "required": {
                "error": "Enter your national ID number",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/address-lookup",
          "overrides": {
            "fieldId": "address-line-1",
            "label": "Address line 1",
            "validations": {
              "required": {
                "error": "Enter your address",
                "value": true
              }
            },
            "geocodeTargets": {
              "line2FieldId": "address-line-2",
              "parishFieldId": "home-parish",
              "coordinatesFieldId": "address-coordinates"
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "address-line-2",
            "label": "Address line 2",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "home-parish",
            "label": "Parish",
            "validations": {
              "required": {
                "error": "Select your parish",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "address-coordinates",
            "label": "Home address coordinates",
            "validations": {
              "required": {
                "value": false
              }
            },
            "ui": {
              "hidden": true
            }
          }
        }
      ]
    },
    {
      "stepId": "contact-details",
      "title": "Contact details",
      "behaviours": [],
      "elements": [
        {
          "ref": "components/email",
          "overrides": {
            "fieldId": "email",
            "validations": {
              "required": {
                "error": "Enter your email address",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/telephone",
          "overrides": {
            "fieldId": "phone-number",
            "validations": {
              "required": {
                "error": "Enter your phone number",
                "value": true
              }
            }
          }
        }
      ]
    },
    {
      "stepId": "workplace-details",
      "title": "Tell us where you plan to work",
      "behaviours": [],
      "elements": [
        {
          "ref": "components/generic-checkbox",
          "overrides": {
            "fieldId": "workplace-locations",
            "label": "Where do you plan to work as a hairdresser?",
            "hint": "Select all that apply.",
            "validations": {
              "required": {
                "error": "Select at least one workplace option",
                "value": true
              }
            },
            "options": [
              {
                "label": "At a salon",
                "value": "at-salon"
              },
              {
                "label": "From home",
                "value": "from-home"
              },
              {
                "label": "At different places for clients",
                "value": "different-places"
              },
              {
                "label": "Somewhere else",
                "value": "somewhere-else"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "salon-name",
            "label": "What is the name of the salon?",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "workplace-locations",
                "operator": "in",
                "value": [
                  "at-salon"
                ]
              }
            ]
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "salon-address-line-1",
            "label": "Address line 1",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "workplace-locations",
                "operator": "in",
                "value": [
                  "at-salon"
                ]
              }
            ]
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "salon-address-line-2",
            "label": "Address line 2",
            "validations": {
              "required": {
                "value": false
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "workplace-locations",
                "operator": "in",
                "value": [
                  "at-salon"
                ]
              }
            ]
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "salon-parish",
            "label": "Parish",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "workplace-locations",
                "operator": "in",
                "value": [
                  "at-salon"
                ]
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "somewhere-else",
            "label": "Where else do you plan to work?",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "workplace-locations",
                "operator": "in",
                "value": [
                  "somewhere-else"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "stepId": "documents",
      "title": "Add your documents",
      "behaviours": [],
      "elements": [
        {
          "ref": "components/upload-document",
          "overrides": {
            "fieldId": "passport-photo",
            "label": "Upload your passport-size photographs.",
            "hint": "These photographs should have been taken recently.",
            "validations": {
              "required": {
                "value": true
              },
              "fileTypes": {
                "error": "Upload a passport-size photograph in JPEG, PNG or GIF format",
                "value": [
                  "image/jpeg",
                  "image/png",
                  "image/gif"
                ]
              },
              "itemMaxSize": {
                "error": "File must be 5 MB or smaller",
                "value": 5242880
              }
            }
          }
        },
        {
          "ref": "components/upload-document",
          "overrides": {
            "fieldId": "medical-certificate",
            "label": "Upload your medical certificate of fitness.",
            "validations": {
              "required": {
                "error": "Your medical certificate is required",
                "value": true
              },
              "fileTypes": {
                "error": "Upload your medical certificate in PDF, JPEG or PNG format",
                "value": [
                  "application/pdf",
                  "image/jpeg",
                  "image/png"
                ]
              },
              "itemMaxSize": {
                "error": "File must be 5 MB or smaller",
                "value": 5242880
              }
            }
          }
        }
      ]
    },
    {
      "stepId": "check-your-answers",
      "title": "Check your answers",
      "behaviours": [],
      "elements": []
    },
    {
      "stepId": "declaration",
      "title": "Confirm and submit your application",
      "behaviours": [],
      "elements": [
        {
          "ref": "components/confirmation",
          "overrides": {
            "fieldId": "declaration-confirmed",
            "label": "Declaration",
            "validations": {
              "required": {
                "error": "You must confirm the declaration to continue",
                "value": true
              }
            },
            "options": [
              {
                "label": "I confirm that my information is correct and I am happy for it to be verified. I understand that false details may lead to my application being rejected, and that the Government of Barbados will keep my information confidential.",
                "value": "confirmed"
              }
            ]
          }
        }
      ]
    },
    {
      "stepId": "submission-confirmation",
      "title": "Application submitted",
      "behaviours": [],
      "markdownContent": "A copy of your request has been sent to the email address you gave and to the Environmental Health Department at **{polyclinic}**.\n\n## What happens next\n\n- Your application goes to the Environmental Health Service associated with your location. If additional information or documentation is required, you will be contacted by an Environmental Health Officer.\n\n**Obtaining your licence:**\n\n- If your application is approved, you will receive a confirmation email and the Environmental Health Office will mail your licence. In addition, you can also request to collect it from your assigned polyclinic.\n\n## Contact\n\nIf you need help, contact the relevant Environmental Health Service office.\n\n- Branford Taitt Polyclinic - [536-3700](tel:+12465363700), [EHD.BTPC@health.gov.bb](mailto:EHD.BTPC@health.gov.bb)\n- David Thompson Health and Social Services Complex - [536-4453](tel:+12465364453), [DTHSSC.EHD@health.gov.bb](mailto:DTHSSC.EHD@health.gov.bb)\n- Eunice Gibson Polyclinic - [536-4033](tel:+12465364033), [EuniceGibsonEHD@health.gov.bb](mailto:EuniceGibsonEHD@health.gov.bb)\n- Maurice Byer Polyclinic - [536-3214](tel:+12465363214), [MBPC.apps@health.gov.bb](mailto:MBPC.apps@health.gov.bb)\n- Randall Phillips Polyclinic - [536-4338](tel:+12465364338), [RPPC.EHD@health.gov.bb](mailto:RPPC.EHD@health.gov.bb)\n- St. Phillip Polyclinic - [536-1240](tel:+12465361240), [StPhilipEHD@health.gov.bb](mailto:StPhilipEHD@health.gov.bb)\n- Winston Scott Polyclinic - [536-3476](tel:+12465363476), [EHD.WSPC@health.gov.bb](mailto:EHD.WSPC@health.gov.bb)",
      "elements": []
    }
  ],
  "processors": [
    {
      "type": "email",
      "config": {
        "recipientField": "contact-details.email",
        "subject": "Your hairdresser licence application has been received"
      }
    },
    {
      "type": "email",
      "config": {
        "recipientField": "catchment.mdaEmail",
        "subject": "A new hairdresser licence application has been received"
      }
    },
    {
      "type": "webhook",
      "config": {
        "method": "POST",
        "signatureHeader": "X-Webhook-Signature",
        "mapping": {
          "programmeCode": "HAIRDRESSER_LICENCE",
          "mdaCode": "MOH",
          "programmeShortCode": "HDL",
          "applicant": {
            "name": [
              "personal-details.first-name",
              "personal-details.last-name"
            ],
            "email": "contact-details.email",
            "phone": "contact-details.phone-number"
          },
          "excludeSteps": [
            "check-your-answers",
            "declaration",
            "submission-confirmation"
          ],
          "groupByStep": true
        },
        "timeoutMs": 10000
      }
    }
  ],
  "createdAt": "2026-08-19T19:09:04.486Z",
