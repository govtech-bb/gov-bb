{
  "formId": "apply-for-funeral-establishment-licence",
  "title": "Apply to Environmental Health for a Funeral Establishment Licence",
  "description": "Use this service to register a funeral establishment.",
  "processors": [
    {
      "type": "email",
      "config": {
        "recipientField": "about-the-applicant.email",
        "subject": "Your funeral establishment licence application has been received"
      }
    },
    {
      "type": "email",
      "config": {
        "recipientField": "catchment.mdaEmail",
        "subject": "A new funeral establishment licence application has been received"
      }
    },
    {
      "type": "webhook",
      "config": {
        "method": "POST",
        "signatureHeader": "X-Webhook-Signature",
        "mapping": {
          "programmeCode": "FUNERAL_ESTABLISHMENT_LICENCE",
          "mdaCode": "MOH",
          "programmeShortCode": "FEM",
          "applicant": {
            "name": [
              "about-the-applicant.first-name",
              "about-the-applicant.last-name"
            ],
            "email": "about-the-applicant.email",
            "phone": "about-the-applicant.telephone"
          },
          "excludeSteps": [
            "check-your-answers",
            "declaration",
            "submission-confirmation"
          ],
          "groupByStep": true
        },
        "timeoutMs": 10000
      }
    }
  ],
  "meta": {
    "visibility": "preview"
  },
  "catchmentRouting": {
    "parishField": "establishment-information.establishment-address-parish",
    "coordinatesField": "establishment-information.establishment-address-coordinates"
  },
  "steps": [
