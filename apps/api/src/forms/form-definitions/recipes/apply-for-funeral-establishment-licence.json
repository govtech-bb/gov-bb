{
  "formId": "apply-for-funeral-establishment-licence",
  "title": "Apply to Environmental Health for a Funeral Establishment Licence",
  "description": "Use this service to register a funeral establishment.",
  "processors": [
    {
      "type": "email",
      "config": {
        "recipientField": "about-the-applicant.email",
        "subject": "Your funeral establishment licence application has been received"
      }
    },
    {
      "type": "email",
      "config": {
        "recipientField": "catchment.mdaEmail",
        "subject": "A new funeral establishment licence application has been received"
      }
    },
    {
      "type": "webhook",
      "config": {
        "method": "POST",
        "signatureHeader": "X-Webhook-Signature",
        "mapping": {
          "programmeCode": "FUNERAL_HOME",
          "mdaCode": "MOH",
          "programmeShortCode": "FHM",
          "applicant": {
            "name": [
              "about-the-applicant.first-name",
              "about-the-applicant.last-name"
            ],
            "email": "about-the-applicant.email",
            "phone": "about-the-applicant.telephone"
          },
          "excludeSteps": [
            "check-your-answers",
            "declaration",
            "submission-confirmation"
          ],
          "groupByStep": true
        },
        "timeoutMs": 10000
      }
    }
  ],
  "meta": {
    "visibility": "preview"
  },
  "catchmentRouting": {
    "parishField": "establishment-information.establishment-address-parish",
    "coordinatesField": "establishment-information.establishment-address-coordinates"
  },
  "steps": [
    {
      "stepId": "about-the-applicant",
      "title": "About you",
      "elements": [
        {
          "ref": "components/first-name",
          "overrides": {
            "fieldId": "first-name",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter your first name"
              }
            }
          }
        },
        {
          "ref": "components/middle-name",
          "overrides": {
            "fieldId": "middle-name",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/last-name",
          "overrides": {
            "fieldId": "last-name",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter your last name"
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 1",
            "fieldId": "address-line-1",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter your address"
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 2",
            "fieldId": "address-line-2",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/email",
          "overrides": {
            "fieldId": "email",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter your email address"
              }
            }
          }
        },
        {
          "ref": "components/telephone",
          "overrides": {
            "fieldId": "telephone",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter a valid telephone number"
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "establishment-information",
      "title": "Establishment information",
      "elements": [
        {
          "ref": "components/generic-text",
          "overrides": {
            "label": "Name of establishment",
            "fieldId": "establishment-name",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the establishment name"
              }
            }
          }
        },
        {
          "ref": "components/address-lookup",
          "overrides": {
            "label": "Address of establishment line 1",
            "fieldId": "establishment-address-line-1",
            "geocodeTargets": {
              "line2FieldId": "establishment-address-line-2",
              "parishFieldId": "establishment-address-parish",
              "coordinatesFieldId": "establishment-address-coordinates"
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address of establishment line 2",
            "fieldId": "establishment-address-line-2",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "establishment-address-parish",
            "validations": {
              "required": {
                "value": true,
                "error": "Select the parish the establishment is in"
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "ui": {
              "hidden": true
            },
            "label": "Establishment address coordinates",
            "fieldId": "establishment-address-coordinates",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "label": "Dimensions of preparation room",
            "fieldId": "preparation-room-dimensions",
            "hint": "Enter the length and width in metres (for example: 5m x 4m)",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the dimensions of the preparation room"
              }
            }
          }
        },
        {
          "ref": "components/generic-number",
          "overrides": {
            "fieldId": "max-bodies",
            "label": "Maximum number of bodies",
            "hint": "What's the maximum number of bodies that can be stored?"
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "staff-information",
      "title": "Staff information",
      "elements": [
        {
          "ref": "components/generic-number",
          "overrides": {
            "fieldId": "male-embalmers",
            "label": "Number of male embalmers"
          }
        },
        {
          "ref": "components/generic-number",
          "overrides": {
            "fieldId": "female-embalmers",
            "label": "Number of female embalmers"
          }
        },
        {
          "ref": "components/upload-document",
          "overrides": {
            "fieldId": "embalmer-list",
            "label": "Upload list of Embalmers",
            "hint": "This is a list of the hired embalmers, with their names, and genders",
            "validations": {
              "required": {
                "value": true,
                "error": "Upload the list of embalmers"
              },
              "fileTypes": {
                "value": [
                  "application/pdf",
                  "image/jpeg",
                  "image/png",
                  ".doc",
                  ".docx",
                  ".xls",
                  ".xlsx"
                ],
                "error": "Upload the list of embalmers as a PDF, image, Word or Excel file"
              },
              "itemMaxSize": {
                "value": 5242880,
                "error": "File must be 5 MB or smaller"
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "check-your-answers",
      "title": "Check your answers",
      "description": "Review all the information you have provided before submitting your application.",
      "elements": [],
      "behaviours": []
    },
    {
      "stepId": "declaration",
      "title": "Declaration",
      "elements": [
        {
          "ref": "components/confirmation",
          "overrides": {
            "label": "Declaration",
            "fieldId": "declaration-confirmed",
            "options": [
              {
                "label": "I confirm that the information provided is true and correct.",
                "value": "confirmed"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "You must confirm the declaration to continue"
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "submission-confirmation",
      "title": "Application submitted",
      "elements": [],
      "behaviours": [],
      "nextSteps": [
        {
          "title": "What happens next",
          "content": "Environmental Health will review your application. They may contact you if they need more information. They will tell you the result and what to do next if your application is approved. You will receive a confirmation email at the address you provided."
        }
      ]
    }
  ],
  "createdAt": "2026-08-25T00:45:35.451Z",
  "updatedAt": "2026-08-26T00:00:00.000Z"
}
