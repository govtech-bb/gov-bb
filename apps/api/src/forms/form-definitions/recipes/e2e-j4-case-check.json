{
  "formId": "e2e-j4-case-check",
  "title": "E2E case-management check (test service)",
  "description": "Internal end-to-end test service for the case-management journey (#3011/#3861). Not a real government service; kept non-public (preview) so it never appears in any citizen-facing listing. Its webhook maps to a reserved E2E_ test programme so a smoke submission creates a removable test case, never a real one (ADR 0087).",
  "steps": [
    {
      "stepId": "details",
      "title": "Your details",
      "elements": [
        {
          "ref": "blocks/personal-information"
        },
        {
          "ref": "components/email"
        },
        {
          "ref": "components/telephone"
        }
      ]
    },
    {
      "stepId": "documents",
      "title": "Supporting document",
      "elements": [
        {
          "ref": "components/upload-document",
          "overrides": {
            "fieldId": "supporting-document",
            "label": "Upload a supporting document",
            "hint": "Upload one file to attach to this test case.",
            "validations": {
              "required": {
                "error": "Upload a supporting document.",
                "value": true
              },
              "fileTypes": {
                "error": "File must be a PDF, JPG or PNG",
                "value": [
                  "application/pdf",
                  "image/jpeg",
                  "image/png",
                  ".pdf",
                  ".jpg",
                  ".jpeg",
                  ".png"
                ]
              },
              "itemMaxSize": {
                "error": "The file must be no larger than 5 MB",
                "value": 5242880
              }
            },
            "ui": {
              "width": "long"
            }
          }
        }
      ]
    },
    {
      "stepId": "check-your-answers",
      "title": "Check your answers",
      "description": "Check the information before you submit your application.",
      "behaviours": [],
      "elements": []
    },
    {
      "stepId": "declaration",
      "title": "Confirm and submit your application",
      "behaviours": [],
      "elements": [
        {
          "ref": "components/confirmation",
          "overrides": {
            "fieldId": "declaration-confirmed",
            "label": "Declaration",
            "validations": {
              "required": {
                "error": "You must confirm the declaration to continue.",
                "value": true
              }
            },
            "options": [
              {
                "label": "I confirm that the information I have provided is true and correct to the best of my knowledge.",
                "value": "confirmed"
              }
            ]
          }
        }
      ]
    },
    {
      "stepId": "submission-confirmation",
      "title": "Application submitted",
      "markdownContent": "## What happens next\n\nThis is an automated end-to-end test service (#3011). No action is needed.",
      "elements": []
    }
  ],
  "processors": [
    {
      "type": "webhook",
      "config": {
        "method": "POST",
        "signatureHeader": "X-Webhook-Signature",
        "mapping": {
          "programmeCode": "E2E_J4_CASE_CHECK",
          "mdaCode": "ETE",
          "programmeShortCode": "EJC",
          "applicant": {
            "name": [
              "details.first-name",
              "details.last-name"
            ],
            "email": "details.email",
            "phone": "details.telephone"
          },
          "excludeSteps": [
            "check-your-answers",
            "declaration",
            "submission-confirmation"
          ],
          "groupByStep": true
        },
        "timeoutMs": 10000
      }
    }
  ],
  "createdAt": "2026-11-24T00:00:00.000Z",
  "updatedAt": "2026-11-24T00:00:00.000Z",
  "meta": {
    "visibility": "preview"
  }
}
