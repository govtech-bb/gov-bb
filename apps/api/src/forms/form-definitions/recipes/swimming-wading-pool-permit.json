{
  "formId": "swimming-wading-pool-permit",
  "title": "App1y for a swimming pool licence with Environmental Health",
  "description": "Apply to Environmental Health for a swimming or wading pool permit",
  "processors": [
    {
      "type": "email",
      "config": {
        "subject": "Your swimming or wading pool permit application has been received",
        "recipientField": "your-details.email"
      }
    }
  ],
  "meta": {
    "visibility": "preview"
  },
  "steps": [
    {
      "stepId": "about-application",
      "title": "About your application",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "label": "Is this a new application or a renewal?",
            "fieldId": "application-type",
            "options": [
              {
                "label": "New application",
                "value": "new"
              },
              {
                "label": "Renewal",
                "value": "renewal"
              }
            ],
            "validations": {
              "required": {
                "value": true
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "your-details",
      "title": "Your details",
      "elements": [
        {
          "ref": "components/first-name"
        },
        {
          "ref": "components/middle-name"
        },
        {
          "ref": "components/last-name"
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 1",
            "fieldId": "your-address-line-1",
            "validations": {
              "required": {
                "error": "Enter your address",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 2",
            "fieldId": "your-address-line-2",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish"
        },
        {
          "ref": "components/email"
        },
        {
          "ref": "components/mobile-telephone"
        },
        {
          "ref": "components/work-telephone"
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "pool-details",
      "title": "Pool details and maintenance",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "label": "Which best describes your application?",
            "fieldId": "owner-type",
            "options": [
              {
                "label": "I own the pool for a business or property",
                "value": "business-owner"
              },
              {
                "label": "I manage or operate the pool for someone else",
                "value": "manager"
              }
            ],
            "validations": {
              "required": {
                "error": "Select an option",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "hint": "For example, manager, employee or authorised representative.",
            "label": "How are you connected to the pool?",
            "fieldId": "connection-to-pool",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "manager",
                "operator": "equal",
                "targetFieldId": "owner-type"
              }
            ],
            "validations": {
              "required": {
                "error": "Enter how you are connected to the pool",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "label": "What type of pool is it?",
            "fieldId": "pool-type",
            "options": [
              {
                "label": "Swimming pool",
                "value": "swimming"
              },
              {
                "label": "Wading pool",
                "value": "wading"
              },
              {
                "label": "Jacuzzi/Hot tub",
                "value": "jacuzzi"
              }
            ],
            "validations": {
              "required": {
                "error": "Select a pool type",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "hint": "If the pool does not have a formal name, enter a simple description, such as home pool or hotel pool.",
            "label": "What is the name of the pool?",
            "fieldId": "pool-name",
            "validations": {
              "required": {
                "error": "Enter the name of the pool",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-number",
          "overrides": {
            "label": "How much water can the pool hold?",
            "fieldId": "pool-water-capacity-number",
            "validations": {
              "gt": {
                "error": "Enter a value greater than 0",
                "value": 0
              },
              "required": {
                "error": "Enter the water capacity",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-select",
          "overrides": {
            "ui": {
              "width": "short"
            },
            "label": "What unit is this measured in?",
            "fieldId": "pool-capacity-unit",
            "options": [
              {
                "label": "Gallons",
                "value": "gallons"
              },
              {
                "label": "Cubic metres",
                "value": "cubic-metres"
              }
            ],
            "validations": {
              "required": {
                "error": "Select a unit",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-checkbox",
          "overrides": {
            "label": "How is the pool mainly used?",
            "fieldId": "pool-usage-type",
            "options": [
              {
                "label": "By guests at a hotel or other accommodation",
                "value": "hotel"
              },
              {
                "label": "By residents of an apartment building or residential complex",
                "value": "apartment"
              },
              {
                "label": "By members of the public",
                "value": "public"
              },
              {
                "label": "Condominiums",
                "value": "condo-home"
              },
              {
                "label": "School",
                "value": "school"
              },
              {
                "label": "Other",
                "value": "other"
              }
            ],
            "validations": {
              "required": {
                "error": "Select how the pool is mainly used",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "label": "Describe how is the pool mainly used",
            "fieldId": "other-pool",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": [
                  "other"
                ],
                "operator": "in",
                "targetStepId": "pool-details",
                "targetFieldId": "pool-usage-type"
              }
            ],
            "validations": {
              "required": {
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "label": "Is the pool at the same address you already entered?",
            "fieldId": "pool-same-address",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "validations": {
              "required": {
                "error": "Select an option",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 1",
            "fieldId": "pool-address-line-1",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "no",
                "operator": "equal",
                "targetFieldId": "pool-same-address"
              }
            ],
            "validations": {
              "required": {
                "error": "Enter the pool address",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 2",
            "fieldId": "pool-address-line-2",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "no",
                "operator": "equal",
                "targetFieldId": "pool-same-address"
              }
            ],
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "label": "Parish",
            "fieldId": "pool-parish",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "no",
                "operator": "equal",
                "targetFieldId": "pool-same-address"
              }
            ],
            "validations": {
              "required": {
                "error": "Select a parish",
                "value": true
              }
            }
          }
        }
      ],
      "behaviours": [
        {
          "max": 5000,
          "min": 1,
          "type": "repeatable",
          "addAnotherLabel": "Do you want to add another pool?"
        }
      ]
    },
    {
      "stepId": "supporting-documents",
      "title": "Supporting documents",
      "elements": [
        {
          "ref": "components/upload-document",
          "overrides": {
            "label": "Town and Country Planning Site Plan",
            "fieldId": "town-country-planning-plan",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "new",
                "operator": "equal",
                "targetStepId": "about-application",
                "targetFieldId": "application-type"
              }
            ],
            "validations": {
              "fileTypes": {
                "error": "Upload a file in PDF, JPEG, PNG, Word or Excel format",
                "value": [
                  "application/pdf",
                  "image/jpeg",
                  "image/png",
                  ".doc",
                  ".docx",
                  ".xls",
                  ".xlsx"
                ]
              }
            }
          }
        },
        {
          "ref": "components/upload-document",
          "overrides": {
            "label": "Pool Plan",
            "fieldId": "pool-plan",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "renewal",
                "operator": "equal",
                "targetStepId": "about-application",
                "targetFieldId": "application-type"
              }
            ],
            "validations": {
              "fileTypes": {
                "error": "Upload a file in PDF, JPEG, PNG, Word or Excel format",
                "value": [
                  "application/pdf",
                  "image/jpeg",
                  "image/png",
                  ".doc",
                  ".docx",
                  ".xls",
                  ".xlsx"
                ]
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "label": "Town and Country Planning Application Number",
            "fieldId": "town-text",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "new",
                "operator": "equal",
                "targetStepId": "about-application",
                "targetFieldId": "application-type"
              }
            ],
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "check-your-answers",
      "title": "Check your answers",
      "description": "Review all the information you have provided before submitting your application.",
      "elements": [],
      "behaviours": []
    },
    {
      "stepId": "declaration",
      "title": "Declaration",
      "elements": [
        {
          "ref": "components/confirmation",
          "overrides": {
            "label": "Declaration",
            "fieldId": "declaration-confirmed",
            "options": [
              {
                "label": "I confirm that the information I have provided is correct.",
                "value": "confirmed"
              }
            ],
            "validations": {
              "required": {
                "error": "You must confirm the declaration to continue",
                "value": true
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "submission-confirmation",
      "title": "Application submitted",
      "elements": [],
      "behaviours": [],
      "nextSteps": [
        {
          "title": "What happens next",
          "content": "Your application for a swimming or wading pool permit has been sent to Environmental Health.\n\nEnvironmental Health will review your application. They may contact you if they need more information or need to inspect the pool. They will let you know the outcome and what you need to do next."
        }
      ]
    }
  ],
  "createdAt": "2026-08-20T09:15:58.120Z",
  "updatedAt": "2026-08-25T00:09:20.776Z",
  "catchmentRouting": {
    "coordinatesField": "your-details.address-coordinates",
    "parishField": "your-details.parish"
  }
}
