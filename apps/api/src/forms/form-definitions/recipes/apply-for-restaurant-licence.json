            "label": "What are you applying to do?",
            "fieldId": "application-type",
            "options": [
              {
                "label": "Apply for a restaurant licence for the first time",
                "value": "first-time"
              },
              {
                "label": "Renew a restaurant licence",
                "value": "renewal"
              }
            ],
            "validations": {
              "required": {
                "error": "Select an option",
                "value": true
              }
            }
          }
        }
      ],
      "behaviours": []
    },
