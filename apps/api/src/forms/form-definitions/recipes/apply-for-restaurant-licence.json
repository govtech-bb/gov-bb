      "behaviours": [
        {
          "type": "stepConditionalOn",
          "targetFieldId": "completing-for",
          "targetStepId": "about-you",
          "operator": "equal",
          "value": "someone-else"
        }
      ]
    },
    {
      "stepId": "about-applicant",
      "title": "About the application",
      "elements": [
        {
          "ref": "components/generic-select",
