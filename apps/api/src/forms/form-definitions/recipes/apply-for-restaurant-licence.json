              {
                "label": "Sunday",
                "value": "sunday"
              }
            ]
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "same-hours-every-day",
            "label": "Are the opening hours the same on every day you are open?",
            "validations": {
              "required": {
                "error": "Select an option",
                "value": true
              }
            },
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "everyday-hours",
            "label": "Opening hours",
            "hint": "These hours apply to every day the restaurant is open. Use the 24-hour clock, for example 09:00 - 17:00.",
            "validations": {
              "required": {
                "error": "Enter the hours the restaurant is open",
                "value": true
              },
              "pattern": {
                "error": "Enter the hours as a start and end time, for example 09:00 - 17:00",
                "value": "^([01]?\\d|2[0-3]):[0-5]\\d\\s*[-–—]\\s*([01]?\\d|2[0-3]):[0-5]\\d$"
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "same-hours-every-day",
                "operator": "equal",
                "value": "yes"
              },
              {
                "type": "fieldArray",
                "min": 1,
                "max": 3,
                "addAnotherLabel": "Add another set of hours"
              }
            ],
            "ui": {
              "width": "short"
            }
          }
        },
