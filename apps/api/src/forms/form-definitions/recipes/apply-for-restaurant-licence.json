{
  "formId": "apply-for-restaurant-licence",
  "title": "Apply to Environmental Health for a restaurant licence",
  "description": "Apply for or renew a restaurant licence",
  "contactDetails": {
    "title": "Ministry of Health and Wellness",
    "telephoneNumber": "+1 (246) 536-3800",
    "email": "info@health.gov.bb"
  },
  "processors": [
    {
      "type": "email",
      "config": {
        "recipientField": "about-you.your-email",
        "subject": "Your restaurant licence application has been received"
      }
    },
    {
      "type": "email",
      "config": {
        "recipientField": "catchment.mdaEmail",
        "subject": "A new restaurant licence application has been received"
      }
    },
    {
      "type": "webhook",
      "config": {
        "method": "POST",
        "signatureHeader": "X-Webhook-Signature",
        "mapping": {
          "programmeCode": "RESTAURANT_LICENCE",
          "mdaCode": "MOH",
          "programmeShortCode": "RSL",
          "applicant": {
            "name": [
              "about-you.your-first-name",
              "about-you.your-last-name"
            ],
            "email": "about-you.your-email",
            "phone": "about-you.your-telephone"
          },
          "excludeSteps": [
            "check-your-answers",
            "declaration",
            "submission-confirmation"
          ],
          "groupByStep": true
        },
        "timeoutMs": 10000
      }
    }
  ],
  "catchmentRouting": {
    "coordinatesField": "about-restaurant.restaurant-address-coordinates",
    "parishField": "about-restaurant.restaurant-parish"
  },
  "meta": {
    "visibility": "preview"
  },
  "steps": [
    {
      "stepId": "about-you",
      "title": "About you",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "completing-for",
            "label": "Are you completing this application for yourself or someone else?",
            "validations": {
              "required": {
                "error": "Select an option",
                "value": true
              }
            },
            "options": [
              {
                "label": "Myself",
                "value": "myself"
              },
              {
                "label": "Someone else or a business or organisation",
                "value": "someone-else"
              }
            ]
          }
        },
        {
          "ref": "components/first-name",
          "overrides": {
            "fieldId": "your-first-name",
            "label": "First name"
          }
        },
        {
          "ref": "components/middle-name",
          "overrides": {
            "fieldId": "your-middle-name",
            "label": "Middle name(s)",
            "hint": "Enter all middle names in order."
          }
        },
        {
          "ref": "components/last-name",
          "overrides": {
            "fieldId": "your-last-name",
            "label": "Last name"
          }
        },
        {
          "ref": "components/telephone",
          "overrides": {
            "fieldId": "your-telephone",
            "label": "Telephone number",
            "behaviours": [
              {
                "type": "fieldArray",
                "min": 1,
                "max": 4,
                "addAnotherLabel": "Add another telephone number"
              }
            ]
          }
        },
        {
          "ref": "components/email",
          "overrides": {
            "fieldId": "your-email",
            "label": "Email address"
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "your-address-line-1",
            "label": "Address line 1"
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "your-address-line-2",
            "label": "Address line 2",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "your-parish"
          }
        },
        {
          "ref": "components/country",
          "overrides": {
            "fieldId": "your-country"
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "applicant-details",
      "title": "Applicant details",
