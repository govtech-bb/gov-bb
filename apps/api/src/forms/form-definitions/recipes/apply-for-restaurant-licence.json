            "fieldId": "relationship-to-restaurant",
            "options": [
              {
                "label": "Owner",
                "value": "owner"
              },
              {
                "label": "Co-owner or partner",
                "value": "co-owner"
              },
              {
                "label": "Director or company officer",
                "value": "director"
              },
              {
                "label": "Manager or operator",
                "value": "manager"
              },
              {
                "label": "Authorised representative",
                "value": "representative"
              },
              {
                "label": "Something else",
                "value": "something-else"
              }
            ],
            "validations": {
              "required": {
                "error": "Select an option",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "label": "Tell us your relationship to the restaurant",
            "fieldId": "relationship-other",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
