            "validations": {
              "required": {
                "value": true,
                "error": "Select at least one day"
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "monday-hours",
            "label": "Monday opening hours",
            "hint": "Use the 24-hour clock, for example 09:00 - 17:00.",
            "ui": {
              "width": "short"
            },
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the hours the restaurant is open on Monday"
              },
              "pattern": {
                "value": "^([01]?\\d|2[0-3]):[0-5]\\d\\s*[-–—]\\s*([01]?\\d|2[0-3]):[0-5]\\d$",
                "error": "Enter the hours as a start and end time, for example 09:00 - 17:00"
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "opening-days",
                "operator": "in",
                "value": [
                  "monday"
                ]
              },
              {
                "type": "fieldArray",
                "min": 1,
                "max": 3,
                "addAnotherLabel": "Add another set of hours for Monday"
