{
  "formId": "apply-for-hotel-licence",
  "title": "Apply for a hotel licence with Environmental Health",
  "description": "Apply for a new Hotel Licence or renew an existing one with Environmental Health",
  "processors": [
    {
      "type": "email",
      "config": {
        "recipientField": "your-details.email",
        "subject": "Your Hotel Licence application has been received"
      }
    },
    {
      "type": "email",
      "config": {
        "recipientField": "catchment.mdaEmail",
        "subject": "A new Hotel Licence application has been received"
      }
    },
    {
      "type": "webhook",
      "config": {
        "method": "POST",
        "signatureHeader": "X-Webhook-Signature",
        "mapping": {
          "programmeCode": "HOTEL_LICENCE",
          "mdaCode": "MOH",
          "programmeShortCode": "HTL",
          "applicant": {
            "name": [
              "your-details.first-name",
              "your-details.last-name"
            ],
            "email": "your-details.email",
            "phone": "your-details.contact-number"
          },
          "excludeSteps": [
            "check-your-answers",
            "declaration",
            "submission-confirmation"
          ],
          "groupByStep": true
        },
        "timeoutMs": 10000
      }
    }
  ],
  "meta": {
    "visibility": "preview"
  },
  "catchmentRouting": {
    "coordinatesField": "hotel-details.hotel-address-coordinates",
    "parishField": "hotel-details.hotel-parish"
  },
  "steps": [
    {
      "stepId": "application-type",
      "title": "Are you applying for a new Hotel Licence or renewing one?",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "application-type",
            "label": "Are you applying for a new Hotel Licence or renewing one?",
            "validations": {
              "required": {
                "error": "Select whether you are applying for a new licence or renewing one.",
                "value": true
              }
            },
            "options": [
              {
                "label": "New licence",
                "value": "new-licence"
              },
              {
                "label": "Renew a licence",
                "value": "renew-licence"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "hotel-licence-number",
            "label": "Hotel Licence number",
            "validations": {
              "required": {
                "error": "Enter the Hotel Licence number.",
                "value": true
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "application-type",
                "operator": "equal",
                "value": "renew-licence"
              }
            ]
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "hotel-operator",
      "title": "The hotel operator",
      "elements": [
        {
          "ref": "components/generic-radio",
