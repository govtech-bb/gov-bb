          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "applying-for",
            "label": "Who are you applying for?",
            "validations": {
              "required": {
                "error": "Select who you are applying for.",
                "value": true
              }
            },
            "options": [
              {
                "label": "Yourself",
                "value": "yourself"
              },
              {
                "label": "Someone else or a business or organisation",
                "value": "someone-else"
              }
            ]
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "has-permission",
            "label": "Do you have permission to apply for this hotel licence?",
            "validations": {
              "required": {
                "error": "Select whether you have permission to apply for this hotel licence.",
                "value": true
              },
              "pattern": {
                "error": "You need permission to apply for this hotel licence.",
                "value": "^yes$"
              }
            },
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "applying-for",
                "operator": "equal",
                "value": "someone-else"
              }
            ]
          }
        },
        {
          "ref": "components/generic-select",
          "overrides": {
            "fieldId": "applicant-hotel-relationship",
            "label": "What is your relationship to the hotel?",
            "validations": {
              "required": {
                "error": "Select your relationship to the hotel.",
                "value": true
              }
            },
            "options": [
              {
                "label": "Owner",
                "value": "owner"
              },
              {
                "label": "Co-owner",
                "value": "co-owner"
              },
              {
                "label": "Director",
                "value": "director"
              },
              {
                "label": "Manager or operator",
                "value": "manager-or-operator"
              },
              {
                "label": "Representative",
                "value": "representative"
