{
  "formId": "apply-for-hotel-licence",
  "title": "Apply to Environmental Health for a hotel licence",
  "description": "Apply for a new hotel licence or renew an existing licence with Environmental Health.",
  "processors": [
    {
      "type": "email",
      "config": {
        "recipientField": "your-details.email",
        "subject": "Your Hotel Licence application has been received"
      }
    },
    {
      "type": "email",
      "config": {
        "recipientField": "catchment.mdaEmail",
        "subject": "A new Hotel Licence application has been received"
      }
    },
    {
      "type": "webhook",
      "config": {
        "method": "POST",
        "signatureHeader": "X-Webhook-Signature",
        "mapping": {
          "programmeCode": "HOTEL_LICENCE",
          "mdaCode": "MOH",
          "programmeShortCode": "HTL",
          "applicant": {
            "name": [
              "your-details.first-name",
              "your-details.last-name"
            ],
            "email": "your-details.email",
            "phone": "your-details.contact-number"
          },
          "excludeSteps": [
            "check-your-answers",
            "declaration",
            "submission-confirmation"
          ],
          "groupByStep": true
        },
        "timeoutMs": 10000
      }
    }
  ],
  "meta": {
    "visibility": "preview"
  },
  "catchmentRouting": {
    "coordinatesField": "hotel-details.hotel-address-coordinates",
    "parishField": "hotel-details.hotel-parish"
  },
  "steps": [
    {
      "stepId": "application-type",
      "title": "Is this a new application or a renewal?",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "application-type",
            "label": "Is this a new application or a renewal?",
            "validations": {
              "required": {
                "error": "Select whether this is a new application or a renewal.",
                "value": true
              }
            },
            "options": [
              {
                "label": "New hotel licence",
                "value": "new-licence"
              },
              {
                "label": "Renewal",
                "value": "renew-licence"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "hotel-licence-number",
            "label": "Hotel licence number",
            "validations": {
              "required": {
                "error": "Hotel licence number is required",
                "value": true
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "application-type",
                "operator": "equal",
                "value": "renew-licence"
              }
            ],
            "ui": {
              "width": "short"
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "applying-for",
      "title": "Who are you applying for?",
