            "validations": {
              "required": {
                "value": true,
                "error": "Enter the business address"
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "business-locations",
                "operator": "in",
                "value": [
                  "business-location"
                ]
              }
            ]
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "business-address-line-2",
            "label": "Address line 2",
            "ui": {
              "hideLabel": false
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "business-locations",
                "operator": "in",
                "value": [
                  "business-location"
                ]
              }
            ]
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "business-parish",
            "validations": {
              "required": {
                "value": true,
                "error": "Select the parish"
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "business-locations",
                "operator": "in",
                "value": [
                  "business-location"
                ]
              }
            ]
          }
        },
        {
          "ref": "components/generic-number",
          "overrides": {
            "fieldId": "business-rooms",
            "label": "How many rooms are used for these services at this location?",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the number of rooms"
              },
              "min": {
                "value": 1,
                "error": "Enter a whole number starting at 1"
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "business-locations",
                "operator": "in",
                "value": [
                  "business-location"
                ]
              }
            ]
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "use-applicant-address-for-home",
            "label": "Do you use the address you gave earlier for your home business?",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Select an option"
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "business-locations",
                "operator": "in",
                "value": [
                  "from-home"
                ]
              }
            ]
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "home-business-address-line-1",
            "label": "Address line 1",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the home business address"
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "use-applicant-address-for-home",
                "operator": "equal",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "home-business-address-line-2",
            "label": "Address line 2",
            "ui": {
              "hideLabel": false
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "use-applicant-address-for-home",
                "operator": "equal",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "home-business-parish",
            "validations": {
              "required": {
                "value": true,
                "error": "Select the parish"
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "use-applicant-address-for-home",
                "operator": "equal",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/generic-number",
          "overrides": {
            "fieldId": "home-rooms",
            "label": "How many rooms are used for these services at home?",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the number of rooms"
              },
              "min": {
                "value": 1,
                "error": "Enter a whole number starting at 1"
              }
