    {
      "stepId": "confirm-and-submit",
      "title": "Confirm and submit your application",
      "elements": [
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "declaration-full-name",
            "label": "Full name",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter your full name"
              }
            }
          }
        }
