            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "business-locations",
                "operator": "in",
                "value": [
                  "from-home"
                ]
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "somewhere-else-details",
            "label": "Where else does the business provide its services?",
            "validations": {
              "required": {
                "value": true,
                "error": "Describe where else the business provides services"
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "business-locations",
                "operator": "in",
                "value": [
                  "somewhere-else"
                ]
              }
            ]
          }
        }
