      "elements": [
        {
          "ref": "components/generic-checkbox",
          "overrides": {
            "fieldId": "business-locations",
            "label": "How does the business provide its services?",
            "hint": "Select all that apply.",
            "options": [
              {
                "label": "At a business location",
                "value": "business-location"
              },
              {
                "label": "At the client's location",
                "value": "client-location"
              },
              {
                "label": "From home",
                "value": "from-home"
              },
              {
                "label": "From a vehicle",
                "value": "from-vehicle"
              },
              {
                "label": "Somewhere else",
                "value": "somewhere-else"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Select at least one location"
              }
            }
          }
