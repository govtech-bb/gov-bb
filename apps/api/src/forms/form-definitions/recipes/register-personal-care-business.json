      "elements": [
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "business-name",
            "label": "What is the name of the business?",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the business name"
              }
            }
          }
        },
        {
          "ref": "components/generic-checkbox",
          "overrides": {
            "fieldId": "business-services",
            "label": "What services will the business provide?",
            "hint": "Select all that apply.",
            "options": [
              {
                "label": "Hairdressing or barbering",
                "value": "hairdressing-barbering"
              },
              {
                "label": "Tattoo services",
                "value": "tattoo-services"
              },
              {
                "label": "Body piercing",
                "value": "body-piercing"
              },
              {
                "label": "Beauty services - for example, waxing, eyebrow treatments, eyelash treatments or makeup.",
                "value": "beauty-services"
              },
              {
                "label": "Spa services - for example, manicures, pedicures, facials, massage, sauna or laser hair removal.",
                "value": "spa-services"
              },
              {
                "label": "Something else",
                "value": "something-else"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Select at least one service"
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "other-services",
      "title": "Tell us about other services",
      "elements": [
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "other-service-name",
            "label": "What other service will the business provide?",
            "hint": "For example, teeth whitening, microblading or another service not listed above.",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the service name"
              }
            }
          }
        },
        {
          "ref": "components/generic-textarea",
          "overrides": {
            "fieldId": "other-service-description",
            "label": "Briefly describe what this service does",
            "hint": "For example, explain what treatment the customer receives or what part of the body the service is for.",
            "ui": {
              "width": "long"
            },
            "validations": {
              "required": {
                "value": true,
                "error": "Describe the service"
              }
            }
          }
        }
      ],
      "behaviours": [
        {
          "type": "repeatable",
          "min": 1,
          "max": 10,
          "addAnotherLabel": "Add another service"
        },
        {
          "type": "stepConditionalOn",
          "targetStepId": "about-the-business",
          "targetFieldId": "business-services",
          "operator": "in",
          "value": [
            "something-else"
          ]
        }
      ]
    },
    {
      "stepId": "where-business-operates",
