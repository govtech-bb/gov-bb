{
  "formId": "register-personal-care-business",
  "title": "Register a personal care business with Environmental Health",
  "description": "Apply to register a personal care business with Environmental Health",
  "processors": [
    {
      "type": "email",
      "config": {
        "recipientField": "about-yourself.applicant-email",
        "subject": "Your application to register a personal care business has been received"
      }
    }
  ],
  "meta": {
    "visibility": "preview"
  },
  "steps": [
    {
      "stepId": "about-yourself",
      "title": "Tell us about yourself",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "registering-for",
            "label": "Are you registering this business for yourself or for someone else?",
            "options": [
              {
                "label": "Myself",
                "value": "myself"
              },
              {
                "label": "Someone else",
                "value": "someone-else"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Select an option"
              }
            }
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "authorised-to-register",
            "label": "Are you authorised to register this business?",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Select an option"
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "registering-for",
                "operator": "equal",
                "value": "someone-else"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "relationship-to-business",
            "label": "What is your relationship to the business?",
            "hint": "For example, manager, director, employee or authorised representative.",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter your relationship to the business"
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "authorised-to-register",
                "operator": "equal",
                "value": "yes"
              }
            ]
          }
        },
        {
          "ref": "components/first-name",
          "overrides": {
            "validations": {
              "required": {
                "value": true,
                "error": "Enter your first name"
              }
            }
          }
        },
        {
          "ref": "components/middle-name",
          "overrides": {
            "label": "Middle name or names",
            "hint": "Enter all middle names in order."
          }
        },
        {
          "ref": "components/last-name",
          "overrides": {
            "validations": {
              "required": {
                "value": true,
                "error": "Enter your last name"
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "applicant-address-line-1",
            "label": "Address line 1",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter your address"
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "applicant-address-line-2",
            "label": "Address line 2",
            "ui": {
              "hideLabel": false
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "applicant-parish",
            "validations": {
              "required": {
                "value": true,
                "error": "Select your parish"
              }
            }
          }
        },
        {
          "ref": "components/email",
          "overrides": {
            "fieldId": "applicant-email",
            "label": "What is your email address?",
            "hint": "We will use this to contact you about your application.",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter a valid email address"
              }
            }
          }
        },
        {
          "ref": "components/telephone",
          "overrides": {
            "fieldId": "applicant-phone",
            "label": "What is your phone number?",
            "hint": "You can enter a Barbados or international number.",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter a valid phone number"
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "about-the-business",
