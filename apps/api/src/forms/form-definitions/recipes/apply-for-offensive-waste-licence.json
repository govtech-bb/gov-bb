    {
      "stepId": "submission-confirmation",
      "title": "Application submitted",
      "behaviours": [],
      "markdownContent": "We have received your application for an offensive trade licence.\n\nKeep your reference number in case you need to contact Environmental Health about your application.\n\nWe have sent a confirmation email to the email address you gave. A copy of your application has been sent to the Environmental Health Department at **{polyclinic}**.\n\n## What happens next\n\n- Environmental Health will review your application.\n- They may inspect the place where you do the work.\n- They will contact you with the result.\n- If your application is approved, they will tell you how to get your licence.\n\nSubmitting an application does not mean that an offensive trade licence has been granted.\n\n## Contact\n\nIf you need help, contact your Environmental Health Service office.\n\n{polyclinicContact}",
      "elements": []
    }
