            "fieldId": "business-activities",
            "label": "What does the business do?",
            "hint": "Select all that apply.",
            "validations": {
              "required": {
                "error": "Select what the business does.",
                "value": true
              }
            },
            "options": [
              {
                "label": "Kill animals for food or other uses, also called slaughtering",
                "value": "slaughtering"
              },
              {
                "label": "Heat animal blood or organs, also called blood or offal boiling",
                "value": "blood-offal-boiling"
              },
              {
                "label": "Heat or crush animal bones, also called bone boiling or crushing",
                "value": "bone-boiling-crushing"
              },
              {
                "label": "Take wool off sheep skins, also called fellmongering",
                "value": "fellmongering"
              },
              {
                "label": "Clean animal guts, also called gut scraping",
                "value": "gut-scraping"
              },
              {
                "label": "Make string from animal guts, also called gut spinning",
                "value": "gut-spinning"
              },
              {
                "label": "Melt animal fat, also called tallow melting",
                "value": "tallow-melting"
              },
              {
                "label": "Make leather from animal skins, also called tanning",
                "value": "tanning"
              },
              {
                "label": "Make chemicals or acids",
                "value": "chemicals-acids"
              },
              {
                "label": "Make glue",
                "value": "glue"
              },
              {
                "label": "Make fertiliser from animal waste, also called manure manufacturing",
                "value": "manure-manufacturing"
              },
              {
                "label": "Make soap by boiling fats or oils, also called soap boiling",
                "value": "soap-boiling"
              }
            ]
