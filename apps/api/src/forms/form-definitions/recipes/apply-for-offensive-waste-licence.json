{
  "formId": "apply-for-offensive-waste-licence",
  "title": "Apply to Environmental Health for an offensive trade licence to do work that may cause fumes, smells or waste",
  "description": "Apply for or renew an offensive trade licence for work that may cause fumes, smells or waste.",
  "steps": [
    {
      "stepId": "application-type",
      "title": "About your application",
      "behaviours": [],
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "application-type",
            "label": "What are you applying to do?",
            "validations": {
              "required": {
                "error": "Select what you are applying to do.",
                "value": true
              }
            },
            "options": [
              {
                "label": "Apply for a new licence",
                "value": "new"
              },
              {
                "label": "Renew your licence",
                "value": "renewal"
              }
            ]
          }
        }
      ]
    },
    {
      "stepId": "renewal-check",
      "title": "Check if you can renew your licence",
      "behaviours": [
        {
          "type": "stepConditionalOn",
          "targetStepId": "application-type",
          "targetFieldId": "application-type",
          "operator": "equal",
          "value": "renewal"
        }
      ],
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "same-licence-holder",
            "label": "Is this licence still for the same person, business or organisation?",
            "validations": {
              "required": {
                "error": "Select whether this licence is still for the same person, business or organisation.",
                "value": true
              },
              "pattern": {
                "error": "You cannot renew this licence if it is now for a different person, business or organisation. Go back and select Apply for a new licence.",
                "value": "^yes$"
              }
            },
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "address-changed",
            "label": "Has the address where you do the work changed?",
            "validations": {
              "required": {
                "error": "Select whether the work address has changed.",
                "value": true
              },
              "pattern": {
                "error": "You cannot renew this licence if the address where you do the work has changed. Go back and select Apply for a new licence.",
                "value": "^no$"
              }
            },
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "building-changes",
            "label": "Have you changed the building, or do you plan to?",
            "validations": {
              "required": {
                "error": "Select whether you have changed the building or plan to.",
                "value": true
              }
            },
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/generic-textarea",
          "overrides": {
            "fieldId": "building-changes-description",
            "label": "What changes have you made, or do you plan to make?",
            "validations": {
              "required": {
                "value": false
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "building-changes",
                "targetStepId": "renewal-check",
                "operator": "equal",
                "value": "yes"
              }
            ],
            "ui": {
              "width": "long"
            }
          }
        }
      ]
    },
    {
