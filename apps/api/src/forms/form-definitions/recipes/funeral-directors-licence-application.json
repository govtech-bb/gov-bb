{
  "formId": "funeral-directors-licence-application",
  "title": "Apply to Environmental Health for a Funeral Directors Licence",
  "description": "Apply for a hairdresser licence in Barbados",
  "processors": [
    {
      "type": "email",
      "config": {
        "subject": "Your hairdresser licence application has been received",
        "recipientField": "personal-details.email"
      }
    },
    {
      "type": "email",
      "config": {
        "subject": "A new hairdresser licence application has been received",
        "recipientField": "catchment.mdaEmail"
      }
    },
    {
      "type": "webhook",
      "config": {
        "method": "POST",
        "mapping": {
          "mdaCode": "MOH",
          "applicant": {
            "name": [
              "personal-details.first-name",
              "personal-details.last-name"
            ],
            "email": "personal-details.email",
            "phone": "personal-details.phone-number"
          },
          "groupByStep": true,
          "excludeSteps": [
            "check-your-answers",
            "declaration",
            "submission-confirmation"
          ],
          "programmeCode": "HAIRDRESSER_LICENCE",
          "programmeShortCode": "HDL"
        },
        "timeoutMs": 10000,
        "signatureHeader": "X-Webhook-Signature"
      }
    }
  ],
  "meta": {
    "visibility": "preview"
  },
  "catchmentRouting": {
    "parishField": "personal-details.home-parish",
    "coordinatesField": "personal-details.address-coordinates"
  },
  "steps": [
    {
      "stepId": "personal-details",
      "title": "Tell us about yourself",
      "elements": [
        {
          "ref": "components/first-name",
          "overrides": {
            "fieldId": "first-name",
            "validations": {
              "required": {
                "error": "Enter your first name",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/middle-name",
          "overrides": {
            "hint": "Enter all middle names in order.",
            "label": "Middle name or names",
            "fieldId": "middle-name"
          }
        },
        {
          "ref": "components/last-name",
          "overrides": {
            "fieldId": "last-name",
            "validations": {
              "required": {
                "error": "Enter your last name",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/address-lookup",
          "overrides": {
            "label": "Address line 1",
            "fieldId": "address-line-1",
            "validations": {
              "required": {
                "error": "Enter your address",
                "value": true
              }
            },
            "geocodeTargets": {
              "line2FieldId": "address-line-2",
              "parishFieldId": "home-parish",
              "coordinatesFieldId": "address-coordinates"
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 2",
            "fieldId": "address-line-2",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "label": "Parish",
            "fieldId": "home-parish",
            "validations": {
              "required": {
                "error": "Select your parish",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "ui": {
              "hidden": true
            },
            "label": "Home address coordinates",
            "fieldId": "address-coordinates",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/email",
          "overrides": {
            "hint": "We will use this to contact you about your application.",
            "label": "What is your email address?",
            "fieldId": "email",
            "validations": {
              "required": {
                "error": "Enter your email address",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/telephone",
          "overrides": {
            "hint": "You can enter a Barbados or international number.",
            "label": "What is your phone number?",
            "fieldId": "phone-number",
            "validations": {
              "required": {
                "error": "Enter your phone number",
                "value": true
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "workplace-details",
      "title": "Tell us where you plan to work",
      "elements": [
        {
          "ref": "components/generic-checkbox",
          "overrides": {
            "hint": "Select all that apply.",
            "label": "Where do you plan to work as a hairdresser?",
            "fieldId": "workplace-locations",
            "options": [
              {
                "label": "At a salon",
                "value": "at-salon"
              },
              {
                "label": "From home",
                "value": "from-home"
              },
              {
                "label": "At different places for clients",
                "value": "different-places"
              },
              {
                "label": "Somewhere else",
                "value": "somewhere-else"
              }
            ],
            "validations": {
              "required": {
                "error": "Select at least one workplace option",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "label": "What is the name of the salon?",
            "fieldId": "salon-name",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": [
                  "at-salon"
                ],
                "operator": "in",
                "targetFieldId": "workplace-locations"
              }
            ]
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 1",
            "fieldId": "salon-address-line-1",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": [
                  "at-salon"
                ],
                "operator": "in",
                "targetFieldId": "workplace-locations"
              }
            ]
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 2",
            "fieldId": "salon-address-line-2",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": [
                  "at-salon"
                ],
                "operator": "in",
                "targetFieldId": "workplace-locations"
              }
            ],
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "label": "Parish",
            "fieldId": "salon-parish",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": [
                  "at-salon"
                ],
                "operator": "in",
                "targetFieldId": "workplace-locations"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "label": "Where else do you plan to work?",
            "fieldId": "somewhere-else",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": [
                  "somewhere-else"
                ],
                "operator": "in",
                "targetFieldId": "workplace-locations"
              }
            ]
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "documents",
      "title": "Add your documents",
      "elements": [
        {
          "ref": "components/upload-document",
          "overrides": {
            "hint": "These photographs should have been taken recently.",
            "label": "Upload your passport-size photographs.",
            "fieldId": "passport-photo",
            "validations": {
              "required": {
                "value": true
              },
              "fileTypes": {
                "error": "Upload a passport-size photograph in JPEG, PNG or GIF format",
                "value": [
                  "image/jpeg",
                  "image/png",
                  "image/gif"
                ]
              },
              "itemMaxSize": {
                "error": "File must be 5 MB or smaller",
                "value": 5242880
              }
            }
          }
        },
        {
          "ref": "components/upload-document",
          "overrides": {
            "label": "Upload your medical certificate of fitness.",
            "fieldId": "medical-certificate",
            "validations": {
              "required": {
                "error": "Your medical certificate is required",
                "value": true
              },
              "fileTypes": {
                "error": "Upload your medical certificate in PDF, JPEG or PNG format",
                "value": [
                  "application/pdf",
                  "image/jpeg",
                  "image/png"
                ]
              },
              "itemMaxSize": {
                "error": "File must be 5 MB or smaller",
                "value": 5242880
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "check-your-answers",
      "title": "Check your answers",
      "elements": [],
      "behaviours": []
    },
    {
      "stepId": "declaration",
      "title": "Confirm and submit your application",
      "elements": [
        {
          "ref": "components/confirmation",
          "overrides": {
            "label": "Declaration",
            "fieldId": "declaration-confirmed",
            "options": [
              {
                "label": "I confirm that the information in this application is true and correct to the best of my knowledge.",
                "value": "confirmed"
              }
            ],
            "validations": {
              "required": {
                "error": "You must confirm the declaration to continue",
                "value": true
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "submission-confirmation",
      "title": "Application submitted",
      "elements": [],
      "behaviours": [],
      "nextSteps": [
        {
          "title": "Your application for a hairdresser licence has been submitted to Environmental Health.",
          "content": "Environmental Health will review your application. They may contact you if they need more information. They will tell you the result and what to do next if your application is approved."
        }
      ]
    }
  ],
  "createdAt": "2026-08-25T14:05:00.922Z",
  "updatedAt": "2026-08-25T14:05:00.922Z"
}
