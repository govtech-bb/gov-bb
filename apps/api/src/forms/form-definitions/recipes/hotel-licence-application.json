        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "is-operator",
            "label": "Are you the operator of the hotel?",
            "hint": "The operator is the person or company that runs the hotel from day to day.",
            "validations": {
              "required": {
                "error": "Select whether you are the operator of the hotel.",
                "value": true
              }
            },
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "operator-name",
            "label": "Operator's name",
            "hint": "This can be a person or a company.",
            "validations": {
              "required": {
                "error": "Enter the operator's name.",
                "value": true
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "is-operator",
                "operator": "equal",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/generic-tel",
          "overrides": {
            "fieldId": "operator-contact-number",
            "label": "Operator's contact number",
            "hint": "You can enter a local or international number.",
            "validations": {
              "required": {
                "error": "Enter a contact number for the operator.",
                "value": true
              },
              "phone": {
                "error": "Enter a contact number for the operator.",
                "value": true
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "is-operator",
                "operator": "equal",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/generic-email",
          "overrides": {
            "fieldId": "operator-email",
            "label": "Operator's email address",
            "validations": {
              "required": {
                "error": "Enter an email address for the operator.",
                "value": true
              },
              "email": {
                "error": "Enter a valid email address.",
                "value": true
