        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "applying-for",
            "label": "Who are you applying for?",
            "ui": {
              "hideLabel": true
            },
            "options": [
              {
                "label": "Yourself",
                "value": "yourself"
              },
              {
                "label": "An organisation",
                "value": "organisation"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Select who you are applying for"
              }
            }
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "has-permission",
            "label": "Do you have permission to apply for the organisation?",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Select whether you have permission to apply for the organisation"
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "applying-for",
                "operator": "equal",
                "value": "organisation"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "relationship-to-organisation",
            "label": "What is your relationship to the organisation?",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter your relationship to the organisation"
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "applying-for",
                "operator": "equal",
                "value": "organisation"
              },
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "has-permission",
                "operator": "equal",
                "value": "yes"
              }
            ]
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "no-permission",
      "title": "You need permission to apply for this organisation",
