{
  "formId": "mohlm-application-use-state-land",
  "title": "Apply to use land owned by the Government of Barbados",
  "description": "Ask the Ministry of Housing, Lands and Maintenance to use land owned by the Government of Barbados",
  "processors": [
    {
      "type": "email",
      "config": {
        "subject": "Application received: use government land",
        "recipientField": "how-should-we-contact-you.email"
      }
    }
  ],
