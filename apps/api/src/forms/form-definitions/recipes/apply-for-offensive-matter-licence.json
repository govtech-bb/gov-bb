      "behaviours": []
    },
    {
      "stepId": "vehicle-details",
      "title": "Vehicle",
      "elements": [
        {
          "ref": "components/generic-text",
          "overrides": {
            "ui": {
              "width": "short"
            },
            "hint": "Enter the number shown on the vehicle's registration documents.",
            "label": "What is the vehicle registration number?",
            "fieldId": "vehicle-registration-number",
            "validations": {
              "required": {
                "error": "Enter the vehicle registration number.",
                "value": true
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "check-your-answers",
      "title": "Check your answers",
      "description": "Review all the information you have provided before submitting your application.",
      "elements": [],
      "behaviours": []
    },
    {
      "stepId": "declaration",
      "title": "Declaration",
      "elements": [
        {
          "ref": "components/confirmation",
          "overrides": {
            "label": "Declaration",
            "fieldId": "declaration-confirmed",
            "options": [
              {
                "label": "I confirm that the information in this application is true and correct to the best of my knowledge.",
                "value": "confirmed"
              }
            ],
            "validations": {
              "required": {
                "error": "Confirm that the information in this application is true and correct.",
                "value": true
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "submission-confirmation",
      "title": "Application submitted",
      "elements": [],
      "behaviours": [],
      "nextSteps": [
        {
          "title": "What happens next",
          "content": "Environmental Health will review your application. They may ask for more information. A Medical Officer of Health will decide whether to approve your vehicle. Environmental Health will tell you the result."
        }
      ]
    }
  ],
