          "overrides": {
            "fieldId": "current-licence",
            "label": "Current licence number",
            "validations": {
              "required": {
                "error": "If renewing, provide your current licence number",
                "value": true
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "application-type",
                "targetStepId": "application-type",
