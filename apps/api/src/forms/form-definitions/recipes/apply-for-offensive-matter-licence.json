          "ref": "components/generic-text",
          "overrides": {
            "label": "Business Name",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "label": "Is your business address the same as the address you gave?",
            "fieldId": "business-address-same",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "validations": {
              "required": {
                "error": "Select whether your business address is the same as the address you gave.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 1",
            "fieldId": "business-address-line-1",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "no",
                "operator": "equal",
                "targetFieldId": "business-address-same"
              }
            ],
            "validations": {
              "required": {
                "error": "Enter your business address.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 2",
            "fieldId": "business-address-line-2",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "no",
                "operator": "equal",
                "targetFieldId": "business-address-same"
              }
            ],
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "label": "Parish",
            "fieldId": "business-parish",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "no",
                "operator": "equal",
                "targetFieldId": "business-address-same"
              }
            ],
            "validations": {
              "required": {
                "error": "Select the parish where the business is located.",
                "value": true
              }
            }
          }
        }
