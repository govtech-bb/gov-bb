    {
      "stepId": "submission-confirmation",
      "title": "Application submitted",
      "behaviours": [],
      "markdownContent": "A copy of your request has been sent to the email address you gave and to the Environmental Health Department at **{polyclinic}**.\n\n## What happens next\n\n* The Environmental Health Department at **{polyclinic}** will review your request.  \n* They will review it and may contact you if they need more information.   \n* The truck(s) will be inspected before a licence is issued.  \n* If your application is approved, you will receive a confirmation email and the Environment Health Office will mail your licence. In addition, you can also request to collect it from your assigned polyclinic.\n\nSubmitting an application does not mean that a licence to carry offensive matter has been granted.\n\n## Contact\n\nIf you need help, contact the relevant Environmental Health Service office.\n\n* Branford Taitt Polyclinic - 536-3700, EHD.BTPC@health.gov.bb  \n* David Thompson Health and Social Services Complex - 536-4453, DTHSSC.EHD@health.gov.bb  \n* Eunice Gibson Polyclinic - 536-4033, EuniceGibsonEHD@health.gov.bb  \n* Maurice Byer Polyclinic - 5363214, MBPC.apps@health.gov.bb  \n* Randall Phillips Polyclinic - 536-4338, RPPC.EHD@health.gov.bb  \n* St. Phillip Polyclinic - 536-1240, StPhilipEHD@health.gov.bb  \n* Winston Scott Polyclinic - 536-3476, EHD.WSPC@health.gov.bb",
      "nextSteps": [
        {
          "title": "What happens next",
          "content": "Environmental Health will review your application. They may ask for more information. A Medical Officer of Health will decide whether to approve your vehicle. Environmental Health will tell you the result."
        }
      ],
      "elements": []
    }
  ],
  "processors": [
    {
      "type": "email",
      "config": {
        "recipientField": "personal-and-contact-details.applicant-email",
        "subject": "Application received: licence to move human or rotting waste"
      }
    },
    {
      "type": "email",
      "config": {
        "recipientField": "catchment.mdaEmail",
        "subject": "A new application for licence to carry offensive matter application has been received"
      }
    },
    {
      "type": "webhook",
      "config": {
        "method": "POST",
        "signatureHeader": "X-Webhook-Signature",
        "mapping": {
          "programmeCode": "OFFENSIVE_MATTER_LICENCE",
          "mdaCode": "MOH",
          "programmeShortCode": "OML",
          "applicant": {
            "name": [
              "personal-and-contact-details.applicant-first-name",
              "personal-and-contact-details.applicant-last-name"
            ],
            "email": "personal-and-contact-details.applicant-email",
            "phone": "personal-and-contact-details.applicant-telephone"
          },
          "excludeSteps": [
            "check-your-answers",
            "declaration",
            "submission-confirmation"
          ],
          "groupByStep": true
        },
        "timeoutMs": 10000
      }
    }
  ],
  "createdAt": "2026-08-24T19:13:52.779Z",
