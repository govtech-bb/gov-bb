{
  "formId": "apply-for-offensive-matter-licence",
  "title": "Apply to Environmental Health for an offensive matter licence to move sewage and other harmful waste",
  "description": "Apply to Environmental Health for a new offensive matter licence, or renew your licence, for each vehicle you use to move sewage and other harmful waste.",
  "steps": [
    {
      "stepId": "applying-for",
      "title": "Who are you applying for?",
      "behaviours": [],
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "applying-for",
            "label": "Who are you applying for?",
            "validations": {
              "required": {
                "error": "Select who you are applying for.",
                "value": true
              }
            },
            "options": [
              {
                "label": "Yourself",
                "value": "yourself"
              },
              {
                "label": "Another person",
                "value": "another-person"
              },
              {
                "label": "A business or organisation",
                "value": "business"
              }
            ]
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "has-permission",
            "label": "Do you have permission to apply?",
            "validations": {
              "required": {
                "error": "Select whether you have permission to apply.",
                "value": true
              },
              "pattern": {
                "error": "You need permission from the person or business before you can apply.",
                "value": "^yes$"
              }
            },
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "applying-for",
                "operator": "in",
                "value": [
                  "another-person",
                  "business"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "stepId": "personal-and-contact-details",
      "title": "Your details",
      "behaviours": [],
      "elements": [
        {
          "ref": "components/first-name",
          "overrides": {
            "fieldId": "applicant-first-name",
            "label": "First name",
            "validations": {
              "required": {
                "error": "Enter your first name.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/middle-name",
          "overrides": {
            "fieldId": "applicant-middle-name",
            "label": "Middle name or names",
            "hint": "Enter all middle names in order.",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/last-name",
          "overrides": {
            "fieldId": "applicant-last-name",
            "label": "Last name",
            "validations": {
              "required": {
                "error": "Enter your last name.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/telephone",
          "overrides": {
            "fieldId": "applicant-telephone",
            "behaviours": [
              {
                "type": "fieldArray",
                "min": 1,
                "max": 3
              }
            ]
          }
        },
        {
          "ref": "components/email",
          "overrides": {
            "fieldId": "applicant-email",
            "label": "Email address",
            "hint": "We will send confirmation of your application to this email address.",
            "validations": {
              "required": {
                "error": "Enter an email address in the correct format, such as name@example.com.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/content",
          "overrides": {
            "fieldId": "applicant-address-heading",
            "content": "## Your address"
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "applicant-address-line-1",
            "label": "Address line 1",
            "validations": {
              "required": {
                "error": "Enter your address.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "applicant-address-line-2",
            "label": "Address line 2",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "applicant-parish",
            "label": "Parish",
            "validations": {
              "required": {
                "error": "Select your parish.",
                "value": true
              }
            }
          }
        }
      ]
    },
    {
      "stepId": "person-details",
      "title": "Tell us about the person you are applying for",
      "behaviours": [
        {
          "type": "stepConditionalOn",
          "targetStepId": "applying-for",
          "targetFieldId": "applying-for",
          "operator": "equal",
          "value": "another-person"
        }
      ],
      "elements": [
        {
          "ref": "components/first-name",
          "overrides": {
            "fieldId": "person-first-name",
            "label": "First name",
            "validations": {
              "required": {
                "error": "Enter their first name.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/middle-name",
          "overrides": {
            "fieldId": "person-middle-name",
            "label": "Middle name or names",
            "hint": "Enter all middle names in order.",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/last-name",
          "overrides": {
            "fieldId": "person-last-name",
            "label": "Last name",
            "validations": {
              "required": {
                "error": "Enter their last name.",
                "value": true
              }
            }
          }
        }
      ]
    },
    {
      "stepId": "business-details",
      "title": "Tell us about the business",
      "behaviours": [
        {
          "type": "stepConditionalOn",
          "targetStepId": "applying-for",
          "targetFieldId": "applying-for",
          "operator": "equal",
          "value": "business"
        }
      ],
      "elements": [
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "business-name",
            "label": "Business or organisation name",
            "validations": {
              "required": {
                "error": "Enter the name of the business or organisation.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "business-relationship",
            "label": "What is your relationship to the business?",
            "hint": "For example, owner, director, manager, employee or representative.",
            "validations": {
              "required": {
                "error": "Enter your relationship to the business.",
                "value": true
              }
            }
          }
        }
      ]
    },
    {
      "stepId": "operator-address",
      "title": "Where is the business or operator located?",
      "description": "We will send your application to the Environmental Health Service office for this area.",
      "behaviours": [],
      "elements": [
        {
          "ref": "components/address-lookup",
          "overrides": {
            "fieldId": "operator-address-line-1",
            "label": "Address line 1",
            "hint": "Start typing the address and choose it from the list.",
            "validations": {
              "required": {
                "error": "Enter the address where the business or operator is located.",
                "value": true
              }
            },
            "geocodeTargets": {
              "line2FieldId": "operator-address-line-2",
              "parishFieldId": "operator-parish",
              "coordinatesFieldId": "operator-address-coordinates"
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "operator-address-line-2",
            "label": "Address line 2",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "operator-parish",
            "label": "Parish",
            "validations": {
              "required": {
                "error": "Select the parish where the business or operator is located.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "operator-address-coordinates",
            "label": "Business or operator location coordinates",
            "validations": {
              "required": {
                "value": false
              }
            },
            "ui": {
              "hidden": true
            }
          }
        }
      ]
    },
    {
      "stepId": "vehicle-details",
      "title": "Tell us about the vehicle",
      "behaviours": [
        {
          "type": "repeatable",
          "min": 1,
          "max": 20,
          "addAnotherLabel": "Do you need to add another vehicle?",
          "instanceLabel": "Vehicle"
        }
      ],
      "elements": [
        {
          "ref": "components/content",
          "overrides": {
            "fieldId": "vehicle-inspection-intro",
            "content": "You can include more than one vehicle if the licences are for the same person or business.\n\nEach vehicle will be inspected before a licence is issued. It must be leakproof, in good working order and have:\n\n- hoses in good condition\n- fresh water for washing down\n- a bucket, shovel and broom"
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "application-type",
            "label": "What are you applying to do for this vehicle?",
            "validations": {
              "required": {
                "error": "Select whether you are applying for a new licence or renewing the licence for this vehicle.",
                "value": true
              }
            },
            "options": [
              {
                "label": "Apply for a new licence",
                "value": "new"
              },
              {
                "label": "Renew the licence",
                "value": "renew"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "vehicle-registration-number",
            "label": "Vehicle registration number",
            "hint": "Enter the number shown on the vehicle's registration documents.",
            "validations": {
              "required": {
                "error": "Enter the vehicle registration number.",
                "value": true
              }
            },
            "ui": {
              "width": "short"
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "current-licence",
            "label": "Current licence number",
            "validations": {
              "required": {
                "value": false
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "application-type",
                "operator": "equal",
                "value": "renew"
              }
            ],
            "ui": {
              "width": "short"
            }
          }
        }
      ]
    },
    {
      "stepId": "check-your-answers",
      "title": "Check your answers",
      "description": "Check the information before you submit your application.",
      "behaviours": [],
      "elements": []
    },
    {
      "stepId": "declaration",
      "title": "Your agreement",
      "behaviours": [],
      "elements": [
        {
          "ref": "components/name",
          "overrides": {
            "fieldId": "declaration-full-name",
            "label": "Full name",
            "validations": {
              "required": {
                "error": "Enter your full name.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-date",
          "overrides": {
            "fieldId": "declaration-date",
            "label": "Date",
            "validations": {
              "required": {
                "error": "Enter the date.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/confirmation",
          "overrides": {
            "fieldId": "declaration-confirmed",
            "label": "Agreement",
            "validations": {
              "required": {
                "error": "Confirm that the information you have provided is true and correct.",
                "value": true
              }
            },
            "options": [
              {
                "label": "I confirm that the information I have provided is true and correct to the best of my knowledge.",
                "value": "confirmed"
              }
            ]
          }
        }
      ]
    },
    {
      "stepId": "submission-confirmation",
      "title": "Application submitted",
      "behaviours": [],
      "markdownContent": "We have received your application.\n\nWe have sent a confirmation email to the email address you gave. A copy has also been sent to the Environmental Health Department at **{polyclinic}**.\n\n## What happens next\n\n- Environmental Health will review your application.\n- Each vehicle will be inspected before a licence is issued.\n- Environmental Health will tell you the result.\n- If your application is approved, they will tell you how to get each licence.\n\n## Get help\n\nIf you need help, contact the Environmental Health Service office for your area.\n\n{polyclinicContact}",
      "elements": []
    }
  ],
  "processors": [
    {
      "type": "email",
      "config": {
        "recipientField": "personal-and-contact-details.applicant-email",
        "subject": "Your application for an offensive matter licence to move sewage and other harmful waste has been received"
      }
    },
    {
      "type": "email",
      "config": {
        "recipientField": "catchment.mdaEmail",
        "subject": "A new application for an offensive matter licence to move sewage and other harmful waste has been received"
      }
    },
    {
      "type": "webhook",
      "config": {
        "method": "POST",
        "signatureHeader": "X-Webhook-Signature",
        "mapping": {
          "programmeCode": "OFFENSIVE_MATTER_LICENCE",
          "mdaCode": "MOH",
          "programmeShortCode": "OMT",
          "applicant": {
            "name": [
              "personal-and-contact-details.applicant-first-name",
              "personal-and-contact-details.applicant-last-name"
            ],
            "email": "personal-and-contact-details.applicant-email",
            "phone": "personal-and-contact-details.applicant-telephone"
          },
          "excludeSteps": [
            "check-your-answers",
            "declaration",
            "submission-confirmation"
          ],
          "groupByStep": true
        },
        "timeoutMs": 10000
      }
    }
  ],
  "createdAt": "2026-08-24T19:13:52.779Z",
  "updatedAt": "2026-10-09T12:00:00.000Z",
  "catchmentRouting": {
    "coordinatesField": "operator-address.operator-address-coordinates",
    "parishField": "operator-address.operator-parish"
  },
  "meta": {
    "visibility": "preview"
  }
}
