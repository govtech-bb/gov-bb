            }
          }
        },
        {
          "ref": "components/mobile-telephone",
          "overrides": {
            "label": "Mobile number",
            "fieldId": "applicant-mobile-number",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/home-telephone",
          "overrides": {
            "label": "Home number",
            "fieldId": "applicant-home-number",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/work-telephone",
          "overrides": {
            "label": "Work number",
            "fieldId": "applicant-work-number",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        }
