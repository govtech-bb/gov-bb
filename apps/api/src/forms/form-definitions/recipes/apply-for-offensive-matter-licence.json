{
  "formId": "apply-for-offensive-matter-licence",
  "title": "Apply for a offensive matter licence with Environmental Health",
  "description": "Apply for a new licence or renew your existing licence to operate a vehicle for moving human or rotting waste.",
  "processors": [
    {
      "type": "email",
      "config": {
        "subject": "Application received: licence to move human or rotting waste",
        "recipientField": "personal-and-contact-details.applicant-email"
      }
    },
    {
      "type": "webhook",
      "config": {
        "method": "POST",
        "signatureHeader": "X-Webhook-Signature",
        "mapping": {
          "programmeCode": "OFFENSIVE_MATTER",
          "mdaCode": "MOH",
          "programmeShortCode": "OMT",
          "applicant": {
            "name": [
              "personal-and-contact-details.applicant-first-name",
              "personal-and-contact-details.applicant-last-name"
            ],
            "email": "personal-and-contact-details.applicant-email",
            "phone": "personal-and-contact-details.applicant-mobile-number"
          },
          "excludeSteps": [
            "check-your-answers",
            "declaration",
            "submission-confirmation"
          ],
          "groupByStep": true
        },
        "timeoutMs": 10000
      }
    }
  ],
  "meta": {
    "visibility": "preview"
  },
  "steps": [
    {
      "stepId": "application-type",
      "title": "Application type",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "label": "Are you applying for a new licence or renewing a licence?",
            "fieldId": "application-type",
            "options": [
              {
                "label": "A new licence",
                "value": "new"
              },
              {
                "label": "Renew a licence",
                "value": "renew"
              }
            ],
            "validations": {
              "required": {
                "error": "Select whether you are applying for a new licence or renewing a licence.",
                "value": true
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "personal-and-contact-details",
      "title": "Tell us about yourself",
      "elements": [
        {
          "ref": "components/first-name",
          "overrides": {
            "label": "First name",
            "fieldId": "applicant-first-name",
            "validations": {
              "required": {
                "error": "Enter your first name.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/middle-name",
          "overrides": {
            "hint": "Enter all middle names in order.",
            "label": "Middle name(s)",
            "fieldId": "applicant-middle-name",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/last-name",
          "overrides": {
            "label": "Last name",
            "fieldId": "applicant-last-name",
            "validations": {
              "required": {
                "error": "Enter your last name.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 1",
            "fieldId": "applicant-address-line-1",
            "validations": {
              "required": {
                "error": "Enter your address.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 2",
            "fieldId": "applicant-address-line-2",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "label": "Parish",
            "fieldId": "applicant-parish",
