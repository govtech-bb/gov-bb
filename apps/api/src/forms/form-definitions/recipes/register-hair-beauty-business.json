            "validations": {
              "required": {
                "value": false
              }
            },
            "hint": "These are the medical certificates for all of your staff."
          }
        },
        {
          "ref": "components/generic-file",
          "overrides": {
            "fieldId": "floor-plan-upload",
            "label": "Upload a floor plan of hairdressing salon",
            "hint": "A drawing of the layout. PDF, JPG or PNG, up to 5MB.",
            "validations": {
              "required": {
                "value": false
              },
              "itemMaxSize": {
                "value": "5242880",
                "error": "The floor plan must be smaller than 5MB."
              }
            }
          }
        },
        {
          "ref": "components/generic-file",
          "overrides": {
            "fieldId": "building-plan-upload",
            "label": "Upload your building plan",
            "hint": "This is the building plan submitted to the Planning and Development Department",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/show-hide",
          "overrides": {
            "fieldId": "building-plan-number",
            "label": "Use tracking number instead"
          }
        },
        {
          "ref": "components/generic-file",
          "overrides": {
            "fieldId": "tracking-number-instead",
            "label": "Planning and Development application number",
            "hint": "This is the application number you received when you submitted your building plans to the Planning and Development Department",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        }
