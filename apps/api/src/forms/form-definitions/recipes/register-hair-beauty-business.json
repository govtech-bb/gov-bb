{
  "formId": "register-hair-beauty-business",
  "title": "Apply to Environmental Health for a hairdressing or beauty business licence",
  "description": "Use this service to register a business that provides hairdressing, barbering, beauty services, manicures or pedicures.",
  "processors": [
    {
      "type": "email",
      "config": {
        "subject": "Your hair or beauty business registration application has been received",
        "recipientField": "contact-details.email"
      }
    }
  ],
  "meta": {
    "visibility": "preview"
  },
  "steps": [
    {
      "stepId": "business-details",
      "title": "Business details",
      "elements": [
        {
          "ref": "components/generic-text",
          "overrides": {
            "label": "Business name",
            "fieldId": "business-name",
            "validations": {
              "required": {
                "error": "Enter the business name",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-select",
          "overrides": {
            "label": "Where will the hairdressing services be provided from?",
            "options": [
              {
                "label": "A fixed building or property",
                "value": "building"
              },
              {
                "label": "A vehicle",
                "value": "vehicle"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "vehicle-licence",
            "label": "Vehicle registration number",
            "hint": "The registration number of the vehicle",
            "ui": {
              "width": "short"
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetStepId": "business-details",
                "targetFieldId": "generic-select",
                "operator": "equal",
                "value": "vehicle"
              }
            ]
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 1",
            "fieldId": "business-address-line-1"
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 2",
            "fieldId": "business-address-line-2",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "business-address-parish"
          }
        },
        {
          "ref": "components/postcode",
          "overrides": {
            "fieldId": "business-address-postcode"
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "new-or-renew",
            "label": "What are you applying to do",
            "options": [
              {
                "label": "Apply for a hairdressing salon licence for the first time",
                "value": "new"
              },
              {
                "label": "Renew a hairdressing salon licence",
                "value": "renew"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "validations": {
              "required": {
                "value": false
              }
