{
  "formId": "nhc-rental-application",
  "title": "Apply for an NHC rental unit or lot",
  "description": "National Housing Corporation application form for a rental unit or lot",
  "steps": [
    {
      "stepId": "eligibility",
      "title": "Check if you can apply",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "income-eligible",
            "label": "Is your monthly income BDS$3,000 or less?",
            "validations": {
              "required": {
                "error": "Tell us whether your monthly income is BDS$3,000 or less",
                "value": true
              },
              "pattern": {
                "error": "You must have a monthly income of BDS$3,000 or less to apply",
                "value": "^yes$"
              }
            },
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/content",
          "overrides": {
            "fieldId": "income-ineligible-notice",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "income-eligible",
                "operator": "equal",
                "value": "no"
              }
            ],
            "content": "To apply for an NHC rental unit or lot, your monthly income must be BDS$3,000 or less. If your circumstances change, you can come back and apply again.",
            "variant": "warning"
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "has-co-applicant",
            "label": "Are you applying with a co-applicant?",
            "validations": {
              "required": {
                "error": "Tell us if you are applying with a co-applicant",
                "value": true
              }
            },
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ]
          }
        }
      ]
    },
    {
      "stepId": "applicant-details",
      "title": "Your details",
      "elements": [
        {
          "ref": "components/first-name"
        },
        {
          "ref": "components/last-name"
        },
        {
          "ref": "components/date-of-birth",
          "overrides": {
            "validations": {
              "required": {
                "error": "Enter your date of birth",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/national-id-number",
          "overrides": {
            "label": "National Registration Number",
            "hint": "You can find this on your national ID card. For example, 870315-1234",
            "validations": {
              "required": {
                "error": "Enter your National Registration Number",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/tamis-number",
          "overrides": {
            "hint": "Your NHC tenant reference number, if you have one"
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Home address",
            "hint": "Street address and village or district",
            "validations": {
              "required": {
                "error": "Enter your home address",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/parish"
        },
        {
          "ref": "components/postcode",
          "overrides": {
            "hint": "For example, BB11000"
          }
        },
        {
          "ref": "components/telephone"
        },
        {
          "ref": "components/email",
          "overrides": {
            "hint": "We will send your confirmation here"
          }
        },
        {
          "ref": "components/generic-select",
          "overrides": {
            "fieldId": "marital-status",
            "label": "Marital status",
            "validations": {
              "required": {
                "error": "Choose your marital status",
                "value": true
              }
            },
            "options": [
              {
                "label": "Single",
                "value": "single"
              },
              {
                "label": "Married",
                "value": "married"
              },
              {
                "label": "Divorced",
                "value": "divorced"
              },
              {
                "label": "Widowed",
                "value": "widowed"
              },
              {
                "label": "Separated",
                "value": "separated"
              }
            ]
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "citizenship",
            "label": "Citizenship status",
            "validations": {
              "required": {
                "error": "Choose your citizenship status",
                "value": true
              }
