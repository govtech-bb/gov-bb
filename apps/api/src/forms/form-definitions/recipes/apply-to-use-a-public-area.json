{
  "formId": "apply-to-use-a-public-area",
  "title": "Apply to use a public park, beach or open area",
  "description": "Apply to the National Conservation Commission for permission to hold an activity, or sell goods or services, at a public park, beach or open area in Barbados.",
  "createdAt": "2026-08-26T00:00:00Z",
  "updatedAt": "2026-08-26T00:00:00Z",
  "contactDetails": {
    "title": "National Conservation Commission",
    "email": "specialprojectsoffice@ncc.gov.bb",
    "telephoneNumber": "+1 (246) 536-0662"
  },
  "processors": [
    {
      "type": "email",
      "config": {
        "subject": "Your application to use a public area has been received",
        "recipientField": "contact-details.email"
      }
    },
    {
      "type": "email",
      "config": {
        "subject": "A new application to use a public area has been received",
        "recipientField": "config.mdaEmail"
      }
    }
  ],
  "steps": [
    {
      "stepId": "applicant-details",
      "title": "Who is applying?",
      "elements": [
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "applicant-name",
            "label": "Name of the individual, business or group",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the name of the individual, business or group applying"
              }
            }
          }
        },
        {
          "ref": "components/name",
          "overrides": {
            "fieldId": "contact-person",
            "label": "Name of the contact person",
            "hint": "This is the person we will contact about the application.",
            "behaviours": [
              {
                "type": "fieldArray",
                "min": 1,
                "max": 3,
                "addAnotherLabel": "Do you need to add another contact person?"
              }
            ]
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "applicant-address-line-1",
            "label": "Address line 1",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "applicant-address-line-2",
            "label": "Address line 2",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        { "ref": "components/nationality" },
        {
          "ref": "components/national-id-number",
          "overrides": {
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        }
      ]
    },
    {
      "stepId": "contact-details",
      "title": "How can we contact you?",
      "elements": [
        { "ref": "components/email" },
        {
          "ref": "components/mobile-telephone",
          "overrides": {
            "validations": {
              "required": {
                "value": true,
                "error": "Enter a mobile number we can reach you on"
              }
            }
          }
        },
        {
          "ref": "components/home-telephone",
          "overrides": {
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/work-telephone",
          "overrides": {
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        }
      ]
    },
    {
      "stepId": "activity-details",
      "title": "About your activity",
      "elements": [
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "activity",
            "label": "What is the activity?",
            "hint": "Tell us what the area will be used for.",
            "validations": {
              "required": {
                "value": true,
                "error": "Tell us what the area will be used for"
              }
            }
          }
        },
        {
          "ref": "components/generic-date",
          "overrides": {
            "fieldId": "activity-date",
            "label": "Date of the activity",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the date of your activity"
              },
              "futureOrToday": {
                "value": true,
                "error": "The date of your activity cannot be in the past"
              }
            }
          }
        },
        {
          "ref": "components/content",
          "overrides": {
            "fieldId": "activity-lead-time-warning",
            "variant": "warning",
            "content": "Your activity is less than three weeks away. The Commission asks for completed applications at least three weeks beforehand. You can still apply, but we may not be able to process it in time.",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "activity-date",
                "transform": "daysUntil",
                "operator": "gte",
                "value": 0
              },
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "activity-date",
                "transform": "daysUntil",
                "operator": "lt",
                "value": 21
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "activity-location",
            "label": "Where will the activity be held?",
            "hint": "Give the park, beach or open area where the activity will take place, or where goods or services will be sold.",
            "validations": {
              "required": {
                "value": true,
                "error": "Tell us where the activity will be held"
              }
            }
          }
        },
        {
          "ref": "components/generic-time",
          "overrides": {
            "fieldId": "activity-start-time",
            "label": "Start time",
            "hint": "The time you want to start. For example, 10:00am.",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the time you want to start"
              }
            }
          }
        },
        {
          "ref": "components/generic-time",
          "overrides": {
            "fieldId": "activity-end-time",
            "label": "End time",
            "hint": "The time you want to finish. For example, 6:00pm.",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the time you want to finish"
              }
            }
          }
        },
        {
          "ref": "components/additional-details",
          "overrides": {
            "fieldId": "goods-services-description",
            "label": "Describe the goods or services you will sell or offer",
            "ui": { "width": "long" },
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        }
      ]
    },
    {
      "stepId": "structures",
      "title": "Structures",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "will-erect-structures",
            "label": "Will you put up any structures?",
            "hint": "For example, tents, stalls, bars or a stage.",
            "options": [
              { "label": "Yes", "value": "yes" },
              { "label": "No", "value": "no" }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Select yes if you will put up any structures"
              }
            }
          }
        },
        {
          "ref": "components/content",
          "overrides": {
            "fieldId": "turtle-stakes-warning",
            "variant": "warning",
            "content": "Stakes cannot be used to put up tents. This helps restore the local marine turtle population.",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "will-erect-structures",
                "operator": "equal",
                "value": "yes"
              }
            ]
          }
        }
      ]
    },
    {
      "stepId": "structure-details",
      "title": "Tell us about a structure you will put up",
      "elements": [
        {
          "ref": "components/generic-select",
          "overrides": {
            "fieldId": "structure-type",
            "label": "Type of structure",
            "options": [
              { "label": "Tent", "value": "tent" },
              { "label": "Stall", "value": "stall" },
              { "label": "Jumping tent", "value": "jumping-tent" },
              { "label": "Bar", "value": "bar" },
              { "label": "Stage", "value": "stage" },
              {
                "label": "Something else - for example, an arch, tables or chairs",
                "value": "other"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Select the type of structure"
              }
            }
          }
        },
        {
          "ref": "components/generic-number",
          "overrides": {
            "fieldId": "structure-quantity",
            "label": "How many will you put up?",
            "ui": { "width": "short" },
            "validations": {
              "required": {
                "value": true,
                "error": "Enter how many you will put up"
              },
              "min": {
                "value": 1,
                "error": "Enter 1 or more"
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "fieldId": "structure-size",
            "label": "Size",
            "hint": "For example, 10ft x 10ft.",
            "ui": { "width": "short" },
            "validations": {
              "required": {
                "value": true,
                "error": "Enter the size of the structure"
              }
            }
          }
        }
      ],
      "behaviours": [
        {
          "type": "repeatable",
          "min": 1,
          "max": 6,
          "instanceLabel": "Structure",
          "addAnotherLabel": "Do you need to add another structure?"
        },
        {
          "type": "stepConditionalOn",
          "targetStepId": "structures",
          "targetFieldId": "will-erect-structures",
          "operator": "equal",
          "value": "yes"
        }
      ]
    },
    {
      "stepId": "services-requested",
      "title": "Services you need from us",
      "elements": [
        {
          "ref": "components/generic-checkbox",
          "overrides": {
            "fieldId": "gazebo-locations",
            "label": "Which gazebo would you like to use?",
            "hint": "Select all that apply.",
            "options": [
              { "label": "Queen's Park", "value": "queens-park" },
              {
                "label": "King George V Memorial Park",
                "value": "king-george-v-memorial-park"
              },
              { "label": "Fitts Village", "value": "fitts-village" },
              { "label": "Silver Sands", "value": "silver-sands" },
              {
                "label": "Farley Hill National Park",
                "value": "farley-hill-national-park"
              },
              { "label": "Speightstown", "value": "speightstown" },
              { "label": "Hastings Rocks", "value": "hastings-rocks" },
              {
                "label": "Bay Street Esplanade",
                "value": "bay-street-esplanade"
              }
            ],
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/generic-checkbox",
          "overrides": {
            "fieldId": "other-services",
            "label": "Which other services do you need?",
            "hint": "Select all that apply.",
            "options": [
              {
                "label": "Use of the Park Hall at King George V Memorial Park",
                "value": "park-hall"
              },
              {
                "label": "Use of the restaurant at Farley Hill National Park",
                "value": "farley-hill-restaurant"
              },
              { "label": "Electricity", "value": "electricity" },
              {
                "label": "Playing music - you will need a C.O.S.C.A.P. certificate, and a loud noise permit if the music is amplified",
                "value": "music"
              },
              { "label": "Using a barbecue grill", "value": "barbecue-grill" },
              { "label": "Ranger or warden service", "value": "ranger-warden" },
              { "label": "Caretaker service", "value": "caretaker" }
            ],
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/generic-number",
          "overrides": {
            "fieldId": "ranger-warden-hours",
            "label": "How many hours of ranger or warden service do you need?",
            "ui": { "width": "short" },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "other-services",
                "operator": "in",
                "value": ["ranger-warden"]
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Enter how many hours of ranger or warden service you need"
              },
              "min": {
                "value": 1,
                "error": "Enter 1 or more"
              }
            }
          }
        },
        {
          "ref": "components/generic-number",
          "overrides": {
            "fieldId": "caretaker-hours",
            "label": "How many hours of caretaker service do you need?",
            "ui": { "width": "short" },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "other-services",
                "operator": "in",
                "value": ["caretaker"]
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Enter how many hours of caretaker service you need"
              },
              "min": {
                "value": 1,
                "error": "Enter 1 or more"
              }
            }
          }
        },
        {
          "ref": "components/content",
          "overrides": {
            "fieldId": "staff-working-hours",
            "variant": "details",
            "summary": "Ranger, warden and caretaker working hours",
            "content": "**Ranger or warden**\n\n1 April to 30 September: 9:30am to 5:30pm\n\n1 October to 31 March: 9:00am to 5:00pm\n\n**Caretaker**\n\n1 April to 30 September: 8:30am to 5:30pm\n\n1 October to 31 March: 8:00am to 5:00pm"
          }
        }
      ]
    },
    {
      "stepId": "supporting-documents",
      "title": "Upload your supporting documents",
      "elements": [
        {
          "ref": "components/content",
          "overrides": {
            "fieldId": "supporting-documents-intro",
            "variant": "inset",
            "content": "You only need to upload the documents that apply to your activity. Each file can be up to 10MB."
          }
        },
        {
          "ref": "components/upload-document",
          "overrides": {
            "fieldId": "public-liability-insurance",
            "label": "Certificate of public liability insurance",
            "hint": "You need this if you expect more than 100 people. It must cover $100,000.",
            "validations": {
              "required": {
                "value": false
              },
              "fileTypes": {
                "value": ["application/pdf", "image/jpeg", "image/png"],
                "error": "The file must be a PDF, JPG or PNG"
              },
              "itemMaxSize": {
                "value": 10485760,
                "error": "The file must be smaller than 10MB"
              }
            }
          }
        },
        {
          "ref": "components/upload-document",
          "overrides": {
            "fieldId": "police-security-receipt",
            "label": "Receipt for security from the Royal Barbados Police Service",
            "validations": {
              "required": {
                "value": false
              },
              "fileTypes": {
                "value": ["application/pdf", "image/jpeg", "image/png"],
                "error": "The file must be a PDF, JPG or PNG"
              },
              "itemMaxSize": {
                "value": 10485760,
                "error": "The file must be smaller than 10MB"
              }
            }
          }
        },
        {
          "ref": "components/upload-document",
          "overrides": {
            "fieldId": "chemical-toilets-payment",
            "label": "Proof of payment for chemical toilets",
            "hint": "The amount can vary depending on your activity and the site.",
            "validations": {
              "required": {
                "value": false
              },
              "fileTypes": {
                "value": ["application/pdf", "image/jpeg", "image/png"],
                "error": "The file must be a PDF, JPG or PNG"
              },
              "itemMaxSize": {
                "value": 10485760,
                "error": "The file must be smaller than 10MB"
              }
            }
          }
        },
        {
          "ref": "components/upload-document",
          "overrides": {
            "fieldId": "health-certificate",
            "label": "Health certificate",
            "hint": "You need this if food will be offered for sale.",
            "validations": {
              "required": {
                "value": false
              },
              "fileTypes": {
                "value": ["application/pdf", "image/jpeg", "image/png"],
                "error": "The file must be a PDF, JPG or PNG"
              },
              "itemMaxSize": {
                "value": 10485760,
                "error": "The file must be smaller than 10MB"
              }
            }
          }
        }
      ]
    },
    {
      "stepId": "declaration",
      "title": "Declaration",
      "elements": [
        {
          "ref": "components/confirmation",
          "overrides": {
            "fieldId": "declaration-confirmed",
            "label": "Declaration",
            "options": [
              {
                "label": "I confirm that the information I have given is true and correct to the best of my knowledge.",
                "value": "confirmed"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "You must confirm the declaration to continue"
              }
            }
          }
        }
      ]
    },
    {
      "stepId": "submission-confirmation",
      "title": "Application submitted",
      "elements": [],
      "nextSteps": [
        {
          "title": "What happens next",
          "content": "We have received your application. You will receive a confirmation email at the address you gave us.\n\nThe Commission aims to process applications within 2 weeks, as long as you have sent all the supporting information and documents we need.\n\nAfter that, contact the PR and Marketing Department to arrange collection:\n\nTelephone: 1-246-536-0662 or 1-246-536-0663\n\nEmail: specialprojectsoffice@ncc.gov.bb"
        }
      ]
    }
  ],
  "meta": { "visibility": "preview" }
}
