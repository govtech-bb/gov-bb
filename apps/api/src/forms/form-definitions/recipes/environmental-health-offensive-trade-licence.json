{
  "formId": "environmental-health-offensive-trade-licence",
  "title": "Apply for a licence offensive trade with Environmental Health",
  "description": "Apply for or renew a licence to carry out work that may produce fumes or strong smells.",
  "processors": [
    {
      "type": "email",
      "config": {
        "recipientField": "your-details.email",
        "subject": "Application received: Environmental Health licence for work that may cause fumes or strong smells"
      }
    }
  ],
  "meta": {
    "visibility": "preview"
  },
  "steps": [
