            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "submission-confirmation",
      "title": "Application submitted",
      "elements": [],
      "behaviours": [],
      "nextSteps": [
        {
          "title": "What happens next",
          "content": "Environmental Health will review your application. They may contact you for more information or arrange an inspection.\n\nThey will contact you with the result. If your application is approved, they will tell you what to do next to get your licence."
        }
      ]
    }
