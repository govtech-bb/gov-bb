      "stepId": "application-type",
      "title": "Your application",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "application-type",
            "label": "Are you applying for a new licence or renewing one?",
            "options": [
              {
                "label": "Applying for a new licence",
                "value": "new"
              },
              {
                "label": "Renewing a licence",
                "value": "renewal"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Select whether you are applying for a new licence or renewing one."
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "your-details",
      "title": "Your details",
      "elements": [
        {
          "ref": "components/first-name",
          "overrides": {
            "validations": {
              "required": {
                "value": true,
                "error": "Enter your first name."
              }
            }
          }
        },
        {
          "ref": "components/middle-name",
          "overrides": {
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/last-name",
          "overrides": {
            "validations": {
              "required": {
                "value": true,
                "error": "Enter your last name."
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "address-line-1",
            "label": "Street address line 1",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter street address line 1."
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "address-line-2",
            "label": "Street address line 2",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish"
        },
        {
          "ref": "components/email",
          "overrides": {
            "hint": "We will send confirmation of your application to this email address.",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter your email address."
              }
            }
          }
        },
        {
          "ref": "components/generic-tel",
          "overrides": {
            "fieldId": "telephone-number",
            "label": "Telephone number",
            "hint": "Enter at least one telephone number.",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter at least one telephone number."
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "renewal-details",
      "title": "Renewal details",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "address-changed",
            "label": "Has the address where you do this work changed since you got your current licence?",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Select whether the address where you do the work has changed."
              }
            }
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "building-changes",
            "label": "Have you made any changes to the building since you got your last licence, or do you plan to?",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Select whether you have made or plan to make changes to the building."
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "address-changed",
                "operator": "equal",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "label": "State the changes you have made",
            "validations": {
              "required": {
                "value": false
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetStepId": "renewal-details",
                "targetFieldId": "building-changes",
                "operator": "equal",
                "value": "yes"
              }
            ]
          }
        }
      ],
      "behaviours": [
        {
          "type": "stepConditionalOn",
          "targetStepId": "application-type",
          "targetFieldId": "application-type",
          "operator": "equal",
          "value": "renewal"
        }
      ]
    },
    {
      "stepId": "work-address",
      "title": "Where you will do the work",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "work-address-same",
            "label": "Is the address where you will do this work the same as your address?",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Select whether the work address is the same as your address."
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "work-address-line-1",
            "label": "Street address line 1",
            "validations": {
              "required": {
                "value": true,
                "error": "Enter street address line 1."
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "work-address-same",
                "operator": "equal",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "fieldId": "work-address-line-2",
            "label": "Street address line 2",
            "validations": {
              "required": {
                "value": false
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "work-address-same",
                "operator": "equal",
                "value": "no"
              }
            ]
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "work-address-parish",
            "label": "Parish",
            "validations": {
              "required": {
                "value": true,
                "error": "Select the parish where you will do this work."
              }
            },
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "work-address-same",
                "operator": "equal",
                "value": "no"
              }
            ]
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "business-activities",
      "title": "What will the business do?",
      "elements": [
        {
          "ref": "components/generic-checkbox",
          "overrides": {
            "fieldId": "business-activities",
            "label": "Business activities",
            "hint": "Select all that apply. We show the legal name in brackets when needed.",
            "options": [
              {
                "label": "Heat animal blood or organs (blood or offal boiling)",
                "value": "blood-offal-boiling"
              },
              {
                "label": "Heat or crush animal bones (bone boiling or crushing)",
                "value": "bone-boiling-crushing"
              },
              {
                "label": "Take wool off sheep skins (fellmongering)",
                "value": "fellmongering"
              },
              {
                "label": "Clean animal guts (gut scraping)",
                "value": "gut-scraping"
              },
              {
                "label": "Make string from animal guts (gut spinning)",
                "value": "gut-spinning"
              },
              {
                "label": "Kill animals for food or other uses (slaughtering)",
                "value": "slaughtering"
              },
              {
                "label": "Melt animal fat (tallow melting)",
                "value": "tallow-melting"
              },
              {
                "label": "Make leather from animal skins (tanning)",
                "value": "tanning"
              },
              {
                "label": "Make chemicals or acids",
                "value": "chemicals-acids"
              },
              {
                "label": "Make glue",
                "value": "glue"
              },
              {
                "label": "Make fertiliser from animal waste (manure manufacturing)",
                "value": "manure-manufacturing"
              },
              {
                "label": "Make soap by boiling fats or oils (soap boiling)",
                "value": "soap-boiling"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Select at least one business activity."
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "building-plans",
      "title": "Upload the plans and details for the building",
      "elements": [
        {
          "ref": "components/upload-document",
          "overrides": {
            "fieldId": "building-plans",
            "label": "Plans and details for the building",
            "hint": "These should show the rooms, work areas and how you will use them. You can upload more than one file.",
            "validations": {
              "fileTypes": {
                "value": [
                  "application/pdf",
                  "image/jpeg",
                  "image/png",
                  ".doc",
                  ".docx"
                ],
                "error": "File must be a PDF, image or document"
              },
              "itemMaxSize": {
                "value": 5242880,
                "error": "Each file must be no larger than 5 MB"
              },
              "maxSize": {
                "value": 20971520,
                "error": "Total file size must be no larger than 20 MB"
              }
            },
            "ui": {
              "width": "long"
            }
          }
        }
      ],
      "behaviours": [
        {
          "type": "stepConditionalOn",
          "targetStepId": "application-type",
          "targetFieldId": "application-type",
          "operator": "equal",
          "value": "new"
        },
        {
          "type": "stepConditionalOn",
          "targetStepId": "renewal-details",
          "targetFieldId": "building-changes",
          "operator": "equal",
          "value": "yes"
        }
      ]
    },
    {
      "stepId": "check-your-answers",
      "title": "Check your answers",
      "description": "Review your answers before you send your application.",
      "elements": [],
      "behaviours": []
    },
    {
      "stepId": "declaration",
      "title": "Your agreement",
      "elements": [
        {
          "ref": "components/confirmation",
          "overrides": {
            "fieldId": "declaration-confirmed",
            "label": "Declaration",
            "options": [
              {
                "label": "I confirm that the information I have provided is true and correct to the best of my knowledge.",
                "value": "confirmed"
              }
            ],
            "validations": {
              "required": {
                "value": true,
                "error": "Confirm that the information you have provided is true and correct to the best of your knowledge."
