    {
      "stepId": "people-working-at-the-food-business",
      "title": "People working at the food business",
      "elements": [
        {
          "ref": "components/content",
          "overrides": {
            "content": "Everyone who handles food needs a valid medical certificate. This includes staff who only sell, serve, store, pack or deliver food, not just the people who cook.",
            "fieldId": "staff-documents-note",
            "variant": "text"
          }
        },
        {
          "ref": "components/generic-number",
          "overrides": {
            "label": "How many male staff will prepare or handle food or drink?",
            "fieldId": "male-staff-count",
            "validations": {
              "required": {
                "error": "Enter the number of male staff",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-number",
          "overrides": {
            "label": "How many female staff will prepare or handle food or drink?",
            "fieldId": "female-staff-count",
            "validations": {
              "required": {
                "error": "Enter the number of female staff",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/upload-document",
          "overrides": {
            "hint": "The list must give each person's name and address. PDF, JPG or PNG, up to 5MB.",
            "label": "Upload a list of your staff",
            "fieldId": "staff-list-upload",
            "validations": {
              "required": {
                "error": "Upload a list of your staff.",
                "value": true
              },
              "fileTypes": {
                "error": "The staff list must be a PDF, JPG or PNG.",
                "value": [
                  "application/pdf",
                  "image/jpeg",
                  "image/png"
                ]
              },
              "itemMaxSize": {
                "error": "The staff list must be smaller than 5MB.",
                "value": 5242880
              }
            }
          }
        },
        {
          "ref": "components/upload-document",
          "overrides": {
            "hint": "You can upload more than one file. PDF, JPG or PNG, up to 5MB each. If you do not have them now, you can bring them to the inspection.",
            "label": "Upload medical certificates for your staff",
            "fieldId": "medical-certificates-upload",
            "multiple": true,
