{
  "formId": "apply-for-food-business-licence",
  "title": "Apply to Environmental Health for a food business licence",
  "description": "Apply for a food business licence in Barbados",
  "steps": [
    {
      "stepId": "about-you",
      "title": "About you",
      "behaviours": [],
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "fieldId": "completing-for",
            "label": "Are you applying as an owner of the food business?",
            "validations": {
              "required": {
                "error": "Select who you are completing the application for.",
                "value": true
              }
            },
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No, I am applying on behalf of the owner",
                "value": "someone-else"
              }
            ]
          }
        },
        {
          "ref": "components/relationship",
          "overrides": {
            "fieldId": "food-business-relationship",
            "label": "What is your relationship to the food business?",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "completing-for",
                "targetStepId": "about-you",
                "operator": "equal",
                "value": "someone-else"
              }
            ],
            "options": [
              {
                "label": "Owner",
                "value": "owner"
              },
              {
                "label": "Co-owner or partner",
                "value": "co-owner"
              },
              {
                "label": "Director or company officer",
                "value": "director-co"
              },
              {
                "label": "Manager or operator",
                "value": "manager-operator"
              },
              {
                "label": "Authorised representative",
                "value": "rep"
              },
              {
                "label": "Something else",
                "value": "something-else"
              }
            ]
          }
        },
        {
          "ref": "components/first-name",
          "overrides": {
            "fieldId": "your-first-name",
            "label": "First name",
            "validations": {
              "required": {
                "error": "Enter your first name.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/middle-name",
          "overrides": {
            "fieldId": "your-middle-name",
            "label": "Middle name(s)",
            "hint": "Enter all middle names in order."
