            "validations": {
              "required": {
                "error": "Enter the applicant's email address.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 1",
            "fieldId": "applicant-address-line-1",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "individual",
                "operator": "equal",
                "targetFieldId": "applicant-type"
              }
            ],
            "validations": {
              "required": {
                "error": "Enter the applicant's address.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 2",
            "fieldId": "applicant-address-line-2",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "individual",
                "operator": "equal",
                "targetFieldId": "applicant-type"
              }
            ],
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "label": "Parish",
            "fieldId": "applicant-parish",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "individual",
                "operator": "equal",
                "targetFieldId": "applicant-type"
              }
            ],
            "validations": {
              "required": {
                "error": "Select the applicant's parish.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/country",
          "overrides": {
            "label": "Country",
            "fieldId": "applicant-country",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "individual",
                "operator": "equal",
                "targetFieldId": "applicant-type"
              }
            ]
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "label": "What are you applying to do?",
            "fieldId": "application-type",
            "options": [
              {
                "label": "Apply for a food business licence for the first time",
                "value": "first-time"
              },
              {
                "label": "Renew a food business licence",
                "value": "renewal"
              }
            ],
            "validations": {
              "required": {
                "error": "Select what you are applying to do.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "hint": "Enter the number shown on your current licence or Environmental Health correspondence.",
            "label": "Licence or reference number",
            "fieldId": "licence-number",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "renewal",
                "operator": "equal",
                "targetFieldId": "application-type"
              }
            ],
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "about-the-food-business",
      "title": "About the food business",
      "elements": [
        {
          "ref": "components/generic-text",
          "overrides": {
            "label": "What type of food business is this?",
            "fieldId": "food-business-type",
            "validations": {
              "required": {
                "error": "Enter the type of food business.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "hint": "Enter the name the food business uses or will use.",
            "label": "What is the food business name?",
            "fieldId": "food-business-name",
            "validations": {
              "required": {
                "error": "Enter the food business name.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-radio",
          "overrides": {
            "label": "Where will the food business operate from?",
            "fieldId": "premises-type",
            "options": [
              {
                "label": "A fixed building or property",
                "value": "fixed-property"
              },
              {
                "label": "A mobile van or trailer",
                "value": "mobile-van"
              },
              {
                "label": "A stall or cart",
                "value": "stall-cart"
              }
            ],
            "validations": {
              "required": {
                "error": "Select where the food business will operate from.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "ui": {
              "width": "short"
            },
            "hint": "The registration number of the van or trailer.",
            "label": "Vehicle registration number",
            "fieldId": "vehicle-registration-number",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "mobile-van",
                "operator": "equal",
                "targetFieldId": "premises-type"
              }
            ],
            "validations": {
              "required": {
                "error": "Enter the vehicle registration number.",
                "value": true
