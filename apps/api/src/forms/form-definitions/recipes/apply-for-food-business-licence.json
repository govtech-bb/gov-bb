{
  "formId": "apply-for-food-business-licence",
  "title": "Apply to Environmental Health for a food business licence",
  "description": "Apply for a food business licence in Barbados",
  "processors": [
    {
      "type": "email",
      "config": {
        "subject": "Your Food Business Licence application has been received",
        "recipientField": "about-you.your-email"
      }
    },
    {
      "type": "email",
      "config": {
        "subject": "A new Food Business Licence application has been received",
        "recipientField": "catchment.mdaEmail"
      }
    },
    {
      "type": "webhook",
      "config": {
        "method": "POST",
        "mapping": {
          "mdaCode": "MOH",
          "applicant": {
            "name": [
              "about-you.your-first-name",
              "about-you.your-last-name"
            ],
            "email": "about-you.your-email",
            "phone": "about-you.your-telephone"
          },
          "groupByStep": true,
          "excludeSteps": [
            "check-your-answers",
            "declaration",
            "submission-confirmation"
          ],
          "programmeCode": "FOOD_BUSINESS_LICENCE",
          "programmeShortCode": "FBL"
        },
        "timeoutMs": 10000,
        "signatureHeader": "X-Webhook-Signature"
      }
    }
  ],
  "catchmentRouting": {
    "coordinatesField": "about-the-food-business.business-location-address-coordinates",
    "parishField": "about-the-food-business.business-location-parish"
  },
  "meta": {
    "visibility": "preview"
  },
  "steps": [
    {
      "stepId": "about-you",
      "title": "About you",
      "elements": [
        {
          "ref": "components/generic-radio",
          "overrides": {
            "label": "Are you completing this application for yourself or someone else?",
            "fieldId": "completing-for",
            "options": [
              {
                "label": "Myself",
                "value": "myself"
              },
              {
                "label": "Someone else or a business or organisation",
                "value": "someone-else"
              }
            ],
            "validations": {
              "required": {
                "error": "Select who you are completing the application for.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/first-name",
          "overrides": {
            "label": "First name",
            "fieldId": "your-first-name",
            "validations": {
              "required": {
                "error": "Enter your first name.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/middle-name",
          "overrides": {
            "hint": "Enter all middle names in order.",
            "label": "Middle name(s)",
            "fieldId": "your-middle-name"
          }
        },
        {
          "ref": "components/last-name",
          "overrides": {
            "label": "Last name",
            "fieldId": "your-last-name",
            "validations": {
              "required": {
                "error": "Enter your last name.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/telephone",
          "overrides": {
            "hint": "You can enter a Barbados or international number. Add another number if more than one owner should be contactable.",
            "label": "Telephone number",
            "fieldId": "your-telephone",
            "behaviours": [
              {
                "max": 4,
                "min": 1,
                "type": "fieldArray",
                "addAnotherLabel": "Add another telephone number"
              }
            ],
            "validations": {
              "required": {
                "error": "Enter a telephone number.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/email",
          "overrides": {
            "label": "Email address",
            "fieldId": "your-email",
            "validations": {
              "required": {
                "error": "Enter an email address.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/content",
          "overrides": {
            "content": "This is your own address. We will use it for any post about this application. You will give the food business address later.",
            "fieldId": "your-address-note",
            "variant": "text"
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 1",
            "fieldId": "your-address-line-1",
            "validations": {
              "required": {
                "error": "Enter your address.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/address",
          "overrides": {
            "label": "Address line 2",
            "fieldId": "your-address-line-2",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        },
        {
          "ref": "components/town",
          "overrides": {
            "label": "Town or district",
            "fieldId": "your-town",
            "validations": {
              "required": {
                "error": "Enter your town or district.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "label": "Parish",
            "fieldId": "your-parish",
            "validations": {
              "required": {
                "error": "Select your parish.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/country",
          "overrides": {
            "label": "Country",
            "fieldId": "your-country",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "st-michael",
                "operator": "notEqual",
                "targetFieldId": "your-parish"
              }
            ]
          }
        }
      ],
      "behaviours": []
    },
    {
      "stepId": "applicant-details",
