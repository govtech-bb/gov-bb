          "ref": "components/generic-radio",
          "overrides": {
            "label": "Is the food business already open?",
            "fieldId": "business-already-open",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "first-time",
                "operator": "equal",
                "targetFieldId": "application-type",
                "targetStepId": "applicant-details"
              }
            ],
            "validations": {
