          "ref": "components/generic-radio",
          "overrides": {
            "label": "Will the food business prepare any food or drink?",
            "fieldId": "will-prepare-food",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "validations": {
              "required": {
                "error": "Select whether the food business will prepare any food or drink.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-checkbox",
          "overrides": {
            "hint": "Select all that apply.",
            "label": "Where will the food or drink be prepared?",
            "fieldId": "preparation-location",
            "options": [
              {
                "label": "At the food business",
                "value": "at-food-business"
              },
              {
                "label": "At another food business or commercial kitchen",
                "value": "at-another-food-business"
              },
              {
                "label": "At another location",
                "value": "at-another-location"
              }
            ],
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": "yes",
                "operator": "equal",
                "targetFieldId": "will-prepare-food"
              }
            ],
            "validations": {
              "required": {
                "error": "Select where the food or drink will be prepared.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/content",
          "overrides": {
            "content": "It is your responsibility to make sure your suppliers have a valid food licence.",
            "fieldId": "supplier-licence-warning",
            "variant": "warning",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "value": [
                  "at-another-food-business",
                  "at-another-location"
                ],
                "operator": "in",
                "targetFieldId": "preparation-location"
              }
            ]
          }
        }
      ],
      "behaviours": []
