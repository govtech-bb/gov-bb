          }
        },
        {
          "ref": "components/address-lookup",
          "overrides": {
            "label": "Address line 1",
            "fieldId": "business-location-address-line-1",
            "validations": {
              "required": {
                "error": "Enter the address where the food business will operate.",
                "value": true
              }
            },
            "geocodeTargets": {
              "line2FieldId": "business-location-address-line-2",
