          }
        },
        {
          "ref": "components/parish",
          "overrides": {
            "label": "Parish",
            "fieldId": "business-location-parish",
            "validations": {
              "required": {
                "error": "Select the parish.",
                "value": true
              }
            }
          }
        },
        {
          "ref": "components/generic-text",
          "overrides": {
            "ui": {
              "hidden": true
            },
            "label": "Food business location coordinates",
            "fieldId": "business-location-address-coordinates",
            "validations": {
              "required": {
                "value": false
              }
            }
          }
        }
