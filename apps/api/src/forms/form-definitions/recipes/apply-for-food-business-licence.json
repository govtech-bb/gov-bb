        },
        {
          "ref": "components/country"
        },
        {
          "ref": "components/parish",
          "overrides": {
            "fieldId": "applicant-parish",
            "behaviours": [
              {
                "type": "fieldConditionalOn",
                "targetFieldId": "country",
                "targetStepId": "applicant-details",
                "operator": "equal",
                "value": "barbados"
              }
            ]
          }
        }
      ]
    },
    {
      "stepId": "application-details",
