{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@govtech-bb/landing-v2-contract": [
        "../../packages/landing-v2-contract/dist/src/index.d.ts"
      ],
      "@govtech-bb/content/markdown-authoring": [
        "../../packages/content/dist/src/markdown-authoring.d.ts"
      ],
      "@govtech-bb/content/categories": [
        "../../packages/content/dist/src/categories.d.ts"
      ]
    }
  },
  "references": [
    { "path": "../../packages/landing-v2-contract" },
    { "path": "../../packages/content" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "**/*.spec.ts", "scripts"]
}
