{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@govtech-bb/landing-v2-contract": [
        "../../packages/landing-v2-contract/src/index.ts"
      ]
    }
  },
  "references": [{ "path": "../../packages/landing-v2-contract" }],
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "**/*.spec.ts", "scripts"]
}
