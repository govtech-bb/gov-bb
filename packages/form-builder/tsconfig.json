{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "../../dist/packages/form-builder",
    "rootDir": "src",
    "strictPropertyInitialization": false,
    "module": "commonjs",
    "moduleResolution": "node10",
    "verbatimModuleSyntax": false,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*"],
  "references": [
    {
      "path": "../form-types"
    },
    {
      "path": "../form-validation"
    },
    {
      "path": "../registry"
    }
  ]
}
